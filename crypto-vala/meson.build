dependencies = [
    dep_gio,
    dep_glib,
    dep_libgcrypt,
    dep_libsrtp2,
]
sources = files(
    'src/cipher.vala',
    'src/cipher_converter.vala',
    'src/error.vala',
    'src/gcrypt_init.c',
    'src/random.vala',
    'src/srtp.vala',
)
c_args = [
    '-DG_LOG_DOMAIN="crypto-vala"',
]
if host_machine.system() == 'windows'
    # Vala 0.56's gio-2.0.vapi still emits GConverter.convert as uint8[] while
    # newer GLib headers expose const void*/void*. This warning is generated by
    # the interface thunk, not by the converter implementation. GCC 14+ warnings
    # are forced by valac unless VALA_STRICT_C disables that generated pragma.
    c_args += ['-DVALA_STRICT_C', '-Wno-incompatible-pointer-types']
endif
vala_args = [
    '--vapidir', vala_source_root / 'crypto-vala/vapi',
]
lib_crypto_vala = library('crypto-vala', sources, c_args: c_args, vala_args: vala_args, dependencies: dependencies, version: '0.0', install: true, install_dir: [true, true, true], install_rpath: default_install_rpath)
dep_crypto_vala = declare_dependency(link_with: lib_crypto_vala, include_directories: include_directories('.'))

install_data('crypto-vala.deps', install_dir: get_option('datadir') / 'vala/vapi', install_tag: 'devel') # TODO: workaround for https://github.com/mesonbuild/meson/issues/9756
