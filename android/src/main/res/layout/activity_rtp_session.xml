<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/penik_call_background"
        android:fitsSystemWindows="true">

        <!-- PiP Placeholder when entering PiP before stream connects -->
        <LinearLayout
            android:id="@+id/pip_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pip_waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateOnly="true"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pip_warning"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_warning_24dp"
                android:visibility="gone"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Remote Video (Full Screen) -->
        <FrameLayout
            android:id="@+id/remote_video_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:visibility="gone">

            <eu.siacs.conversations.ui.widget.SurfaceViewRenderer
                android:id="@+id/remote_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:soundEffectsEnabled="false" />
        </FrameLayout>

        <!-- Local Video PiP Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/local_video_card"
            android:layout_width="108dp"
            android:layout_height="160dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@android:color/black"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            android:visibility="gone">

            <eu.siacs.conversations.ui.widget.SurfaceViewRenderer
                android:id="@+id/local_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:soundEffectsEnabled="false" />
        </androidx.cardview.widget.CardView>

        <!-- Minimalist Transparent Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIconTint="@android:color/white"
                app:titleTextColor="@android:color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Center Call Profile & Info Container -->
        <LinearLayout
            android:id="@+id/call_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Support Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/support_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="#3D1D1D"
                app:cardCornerRadius="12dp"
                app:strokeColor="#5C2626"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/no_support_av_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning_24dp"
                        app:tint="#F05A5A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/clients_may_not_support_av"
                        android:textColor="#F05A5A"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Big Circular Avatar (112dp) -->
            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/contact_photo"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circular"
                    tools:src="@drawable/ic_account_circle_24dp" />
            </FrameLayout>

            <!-- Peer Display Name -->
            <TextView
                android:id="@+id/with"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                tools:text="Пользователь" />

            <!-- Peer JID (when relevant) -->
            <TextView
                android:id="@+id/with_jid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="user@example.com" />

            <!-- Call State / Subtitle -->
            <TextView
                android:id="@+id/call_state_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                tools:text="Входящий звонок" />

            <!-- Call Duration Timer -->
            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="01:23" />

            <!-- E2EE Safety Words Pill (Collapsed) -->
            <LinearLayout
                android:id="@+id/safety_words_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/penik_call_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/verified"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock_24dp"
                    app:tint="@color/penik_call_accept" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/safety_word_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/penik_call_word_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        tools:text="алмаз" />

                    <TextView
                        android:id="@+id/safety_word_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/penik_call_word_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        tools:text="волна" />

                    <TextView
                        android:id="@+id/safety_word_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/penik_call_word_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        tools:text="гвардия" />

                    <TextView
                        android:id="@+id/safety_word_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/penik_call_word_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        tools:text="маяк" />
                </LinearLayout>
            </LinearLayout>

            <!-- E2EE Safety Words Card (Expanded) -->
            <LinearLayout
                android:id="@+id/safety_words_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <!-- Hide Words Pill Button -->
                <LinearLayout
                    android:id="@+id/safety_hide_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/penik_call_pill_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_keyboard_arrow_up_24dp"
                        app:tint="#E6FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/penik_call_safety_hide_words"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Full Info Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/penik_call_safety_card_bg"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <!-- 4 Large Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/card_safety_word_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/penik_call_word_badge"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:text="алмаз" />

                        <TextView
                            android:id="@+id/card_safety_word_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/penik_call_word_badge"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:text="волна" />

                        <TextView
                            android:id="@+id/card_safety_word_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/penik_call_word_badge"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:text="гвардия" />

                        <TextView
                            android:id="@+id/card_safety_word_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/penik_call_word_badge"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:text="маяк" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/penik_call_safety_card_title"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/safety_card_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#D9FFFFFF"
                        android:textSize="12sp"
                        tools:text="Если Собеседник видит те же слова, что и Вы, звонок на 100% защищён." />
                </LinearLayout>
            </LinearLayout>

            <!-- Using Account Notice -->
            <TextView
                android:id="@+id/using_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#66FFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Используется аккаунт me@penik.ru" />

        </LinearLayout>

        <!-- Floating PiP Indicator when muted -->
        <ImageView
            android:id="@+id/pip_local_mic_off_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:alpha="0.8"
            android:src="@drawable/ic_mic_off_24dp"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- Bottom Controls Area -->
        <LinearLayout
            android:id="@+id/button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Incoming / Terminal Call Action Row (Reject / Accept / Retry / Exit) -->
            <LinearLayout
                android:id="@+id/incoming_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Reject / Cancel / Exit Button Column -->
                <LinearLayout
                    android:id="@+id/reject_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/reject_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/dismiss_call"
                        android:src="@drawable/ic_call_end_24dp"
                        app:backgroundTint="@color/penik_call_hangup"
                        app:borderWidth="0dp"
                        app:elevation="4dp"
                        app:fabCustomSize="64dp"
                        app:maxImageSize="30dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/reject_call_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/dismiss_call"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Accept / Retry Button Column -->
                <LinearLayout
                    android:id="@+id/accept_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/accept_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/answer_call"
                        android:src="@drawable/ic_call_24dp"
                        app:backgroundTint="@color/penik_call_accept"
                        app:borderWidth="0dp"
                        app:elevation="4dp"
                        app:fabCustomSize="64dp"
                        app:maxImageSize="30dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/accept_call_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/answer_call"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Connected / In-Call Action Row (Mic, Speaker/Video, Hangup, Flip) -->
            <LinearLayout
                android:id="@+id/in_call_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left Action: Mic (Mute/Unmute) -->
                <LinearLayout
                    android:id="@+id/in_call_action_left_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_mic_24dp"
                        app:backgroundTint="@color/penik_call_button_bg"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:fabCustomSize="56dp"
                        app:maxImageSize="26dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/in_call_action_left_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Микрофон"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Middle Left Action: Speaker or Video Toggle -->
                <LinearLayout
                    android:id="@+id/in_call_action_right_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_volume_up_24dp"
                        app:backgroundTint="@color/penik_call_button_bg"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:fabCustomSize="56dp"
                        app:maxImageSize="26dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/in_call_action_right_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Динамик"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Far Right Action: Flip Camera -->
                <LinearLayout
                    android:id="@+id/in_call_action_far_right_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/in_call_action_far_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_flip_camera_android_24dp"
                        app:backgroundTint="@color/penik_call_button_bg"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:fabCustomSize="56dp"
                        app:maxImageSize="26dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/in_call_action_far_right_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Поворот"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- End Call Button Column -->
                <LinearLayout
                    android:id="@+id/end_call_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/end_call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/hang_up"
                        android:src="@drawable/ic_call_end_24dp"
                        app:backgroundTint="@color/penik_call_hangup"
                        app:borderWidth="0dp"
                        app:elevation="4dp"
                        app:fabCustomSize="64dp"
                        app:maxImageSize="30dp"
                        app:rippleColor="#40FFFFFF"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/end_call_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Завершить"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</layout>
