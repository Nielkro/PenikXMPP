#: plugins/omemo/src/ui/manage_key_dialog.vala
msgid "Older hidden messages have no recorded fingerprint and cannot be safely assigned to this key."
msgstr "Bei älteren ausgeblendeten Nachrichten wurde kein Fingerabdruck gespeichert. Sie können diesem Schlüssel nicht sicher zugeordnet werden."

#: plugins/omemo/src/ui/encryption_preferences_entry.vala
