msgstr ""
"La chiave OpenPGP per XMPP del contatto non è ancora stata aggiornata."

#: plugins/openpgp/src/manager.vala:425
msgid "This contact has no legacy OpenPGP/XEP-0027 key."
msgstr "Questo contatto non ha una chiave OpenPGP precedente/XEP-0027."

#: plugins/openpgp/src/manager.vala:438
#, c-format
msgid "OpenPGP key lookup failed: %s"
msgstr "Ricerca della chiave OpenPGP non riuscita: %s"

#: plugins/openpgp/src/manager.vala:442
msgid "No OpenPGP keys are available for the group members."
msgstr "Nessuna chiave OpenPGP disponibile per i membri del gruppo."

#: plugins/openpgp/src/plugin.vala:432
msgid "OpenPGP Passphrase Required"
msgstr "Passphrase OpenPGP richiesta"

#: plugins/openpgp/src/plugin.vala:433
msgid "Enter the passphrase for your OpenPGP key to continue."
msgstr "Inserisci la passphrase della tua chiave OpenPGP per continuare."

#: plugins/openpgp/src/plugin.vala:449
msgid "Passphrase"
msgstr "Passphrase"

#: plugins/openpgp/src/plugin.vala:454
