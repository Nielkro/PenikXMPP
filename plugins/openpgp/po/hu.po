#: plugins/openpgp/src/contact_details_provider.vala:163
msgid "OpenPGP Legacy (XEP-0027/keyserver)"
msgstr "Régi OpenPGP (XEP-0027/kulcsszerver)"

#: plugins/openpgp/src/contact_details_provider.vala:176
msgid "Search keyserver"
msgstr "Keresés a kulcsszerveren"

#: plugins/openpgp/src/contact_details_provider.vala:184
msgid "OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/contact_details_provider.vala:196
msgid "Copy XMPP-published OpenPGP fingerprint"
msgstr "XMPP-n közzétett OpenPGP-ujjlenyomat másolása"

#: plugins/openpgp/src/contact_details_provider.vala:205
msgid "Mark XMPP-published key as verified"
msgstr "XMPP-n közzétett kulcs megjelölése ellenőrzöttként"

#: plugins/openpgp/src/contact_details_provider.vala:211
msgid "Reset XMPP-published key verification"
msgstr "XMPP-n közzétett kulcs ellenőrzésének alaphelyzetbe állítása"

#: plugins/openpgp/src/contact_details_provider.vala:226
msgid "Refresh XMPP-published key"
msgstr "XMPP-n közzétett kulcs frissítése"

#: plugins/openpgp/src/contact_details_provider.vala:337
msgid "Checking XMPP-published OpenPGP key..."
msgstr "XMPP-n közzétett OpenPGP-kulcs ellenőrzése..."

#: plugins/openpgp/src/contact_details_provider.vala:350
msgid "Checking the XMPP-published OpenPGP key timed out."
msgstr ""
"Az XMPP-n közzétett OpenPGP-kulcs ellenőrzése túllépte az időkorlátot."

#: plugins/openpgp/src/contact_details_provider.vala:389
msgid "Checking keyring..."
msgstr "Kulcstartó ellenőrzése..."

#: plugins/openpgp/src/contact_details_provider.vala:427
msgid "Invalid for legacy XEP-0027/keyserver: key has no email user ID."
msgstr ""
"Érvénytelen a régi XEP-0027/kulcsszerver használatához: a kulcsnak nincs "
"e-mailes felhasználóazonosítója."

#: plugins/openpgp/src/contact_details_provider.vala:428
msgid "Invalid for OpenPGP for XMPP: key has no matching xmpp: user ID."
msgstr ""
"Érvénytelen az OpenPGP for XMPP használatához: a kulcsnak nincs megfelelő "
"xmpp: felhasználóazonosítója."

#: plugins/openpgp/src/contact_details_provider.vala:439
msgid "Key not in keyring"
msgstr "A kulcs nincs a kulcstartóban"

#: plugins/openpgp/src/contact_details_provider.vala:446
msgid ""
"Active: legacy XEP-0027/keyserver key is currently usable for this contact."
msgstr ""
"Aktív: a régi XEP-0027/kulcsszerver-kulcs jelenleg használható ennél a "
"partnernél."

#: plugins/openpgp/src/contact_details_provider.vala:449
msgid ""
"Stored: legacy XEP-0027/keyserver key is known, but is not currently active "
"for this contact."
msgstr ""
"Tárolt: a régi XEP-0027/kulcsszerver-kulcs ismert, de jelenleg nem aktív "
"ennél a partnernél."

#: plugins/openpgp/src/contact_details_provider.vala:451
msgid "Inactive: no legacy XEP-0027/keyserver key is stored."
msgstr "Inaktív: nincs tárolt régi XEP-0027/kulcsszerver-kulcs."

#: plugins/openpgp/src/contact_details_provider.vala:457
msgid "Verified: XMPP-published OpenPGP key is stored and manually verified."
msgstr ""
"Ellenőrzött: az XMPP-n közzétett OpenPGP-kulcs tárolva és kézzel "
"ellenőrizve."

#: plugins/openpgp/src/contact_details_provider.vala:460
msgid ""
"Changed: XMPP-published OpenPGP key differs from the previously verified "
"key. Verify the fingerprint before trusting this identity."
msgstr ""
"Megváltozott: az XMPP-n közzétett OpenPGP-kulcs eltér a korábban "
"ellenőrzöttől. Az identitás megbízhatónak tekintése előtt ellenőrizd az "
"ujjlenyomatot."

#: plugins/openpgp/src/contact_details_provider.vala:462
msgid ""
"Unverified: XMPP-published OpenPGP key is stored. Compare the fingerprint "
"before trusting this identity."
msgstr ""
"Ellenőrizetlen: az XMPP-n közzétett OpenPGP-kulcs tárolva. Az identitás "
"megbízhatónak tekintése előtt hasonlítsd össze az ujjlenyomatot."

#: plugins/openpgp/src/contact_details_provider.vala:465
msgid ""
"Supported: contact advertises OpenPGP for XMPP, but no retrievable XMPP-"
"published key is stored."
msgstr ""
"Támogatott: a partner hirdeti az OpenPGP for XMPP támogatását, de nincs "
"tárolt, lekérhető XMPP-n közzétett kulcs."

#: plugins/openpgp/src/contact_details_provider.vala:467
msgid "Inactive: no OpenPGP-for-XMPP support or XMPP-published key is known."
msgstr ""
"Inaktív: nem ismert OpenPGP for XMPP támogatás vagy XMPP-n közzétett kulcs."

#: plugins/openpgp/src/contact_details_provider.vala:497
msgid "Fingerprint copied"
msgstr "Ujjlenyomat másolva"

#: plugins/openpgp/src/contact_details_provider.vala:520
msgid "Verifying OpenPGP-for-XMPP key..."
msgstr "OpenPGP for XMPP kulcs ellenőrzése..."

#: plugins/openpgp/src/contact_details_provider.vala:554
msgid ""
"Cannot verify: key is not in the keyring or has no matching xmpp: user ID."
msgstr ""
"Nem ellenőrizhető: a kulcs nincs a kulcstartóban, vagy nincs megfelelő xmpp:"
" felhasználóazonosítója."

#: plugins/openpgp/src/contact_details_provider.vala:611
msgid "Searching keyserver with fingerprint: "
msgstr "Keresés a kulcsszerveren ezzel az ujjlenyomattal: "

#: plugins/openpgp/src/contact_details_provider.vala:626
msgid ""
"Key not found or has no verified email on keyserver.\n"
"Ask the contact to verify their email on keys.openpgp.org\n"
"or send you their public key file directly."
msgstr ""
"A kulcs nem található, vagy nincs ellenőrzött e-mail-címe a kulcsszerveren.\n"
"Kérd meg a partnert, hogy igazolja e-mail-címét a keys.openpgp.org oldalon,\n"
"vagy küldje el közvetlenül a nyilvános kulcsfájlját."

#: plugins/openpgp/src/contact_details_provider.vala:628
msgid "Failed: "
msgstr "Sikertelen: "

#: plugins/openpgp/src/contact_details_provider.vala:636
msgid "Searching keyserver with JID..."
msgstr "Keresés a kulcsszerveren JID alapján..."

#: plugins/openpgp/src/contact_details_provider.vala:657
msgid "Not found with JID. Enter email address:"
msgstr "JID alapján nem található. Adj meg e-mail-címet:"

#: plugins/openpgp/src/contact_details_provider.vala:668
msgid "Enter Email Address"
msgstr "E-mail-cím megadása"

#: plugins/openpgp/src/contact_details_provider.vala:669
msgid ""
"The key was not found using the JID.\n"
"\n"
"Enter the email address that is in the contact's OpenPGP key:"
msgstr ""
"A kulcs JID alapján nem található.\n"
"\n"
"Add meg a partner OpenPGP-kulcsában szereplő e-mail-címet:"

#: plugins/openpgp/src/contact_details_provider.vala:671
#: plugins/openpgp/src/key_management_dialog.vala:1045
#: plugins/openpgp/src/key_management_dialog.vala:1486
#: plugins/openpgp/src/key_management_dialog.vala:1654
#: plugins/openpgp/src/key_management_dialog.vala:1694
#: plugins/openpgp/src/key_management_dialog.vala:1789
#: plugins/openpgp/src/key_management_dialog.vala:1924
#: plugins/openpgp/src/key_management_dialog.vala:2108
#: plugins/openpgp/src/key_management_dialog.vala:2270
#: plugins/openpgp/src/key_management_dialog.vala:2866
#: plugins/openpgp/src/key_management_dialog.vala:3211
