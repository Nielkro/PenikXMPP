#: plugins/openpgp/src/contact_details_provider.vala:163
msgid "OpenPGP Legacy (XEP-0027/keyserver)"
msgstr "OpenPGP ותיק (XEP-0027/שרת מפתחות)"

#: plugins/openpgp/src/contact_details_provider.vala:176
msgid "Search keyserver"
msgstr "חפש בשרת מפתחות"

#: plugins/openpgp/src/contact_details_provider.vala:184
msgid "OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/contact_details_provider.vala:196
msgid "Copy XMPP-published OpenPGP fingerprint"
msgstr "העתק את טביעת האצבע של מפתח OpenPGP שפורסם דרך XMPP"

#: plugins/openpgp/src/contact_details_provider.vala:205
msgid "Mark XMPP-published key as verified"
msgstr "סמן מפתח שפורסם דרך XMPP כמאומת"

#: plugins/openpgp/src/contact_details_provider.vala:211
msgid "Reset XMPP-published key verification"
msgstr "אפס את האימות של מפתח שפורסם דרך XMPP"

#: plugins/openpgp/src/contact_details_provider.vala:226
msgid "Refresh XMPP-published key"
msgstr "רענן מפתח שפורסם דרך XMPP"

#: plugins/openpgp/src/contact_details_provider.vala:337
msgid "Checking XMPP-published OpenPGP key..."
msgstr "בודק מפתח OpenPGP שפורסם דרך XMPP…"

#: plugins/openpgp/src/contact_details_provider.vala:350
msgid "Checking the XMPP-published OpenPGP key timed out."
msgstr "הזמן המוקצב לבדיקת מפתח OpenPGP שפורסם דרך XMPP חלף."

#: plugins/openpgp/src/contact_details_provider.vala:389
msgid "Checking keyring..."
msgstr "בודק צרור מפתחות..."

#: plugins/openpgp/src/contact_details_provider.vala:427
msgid "Invalid for legacy XEP-0027/keyserver: key has no email user ID."
msgstr "לא חוקי עבור XEP-0027/שרת מפתח מדור קודם: למפתח אין מזהה משתמש בדוא\"ל."

#: plugins/openpgp/src/contact_details_provider.vala:428
msgid "Invalid for OpenPGP for XMPP: key has no matching xmpp: user ID."
msgstr "לא תקין עבור OpenPGP for XMPP: למפתח אין מזהה משתמש xmpp: תואם."

#: plugins/openpgp/src/contact_details_provider.vala:439
msgid "Key not in keyring"
msgstr "מפתח לא בצרור מפתחות"

#: plugins/openpgp/src/contact_details_provider.vala:446
msgid ""
"Active: legacy XEP-0027/keyserver key is currently usable for this contact."
msgstr "פעיל: מפתח XEP-0027/שרת מפתח מדור קודם ניתן לשימוש עבור איש קשר זה."

#: plugins/openpgp/src/contact_details_provider.vala:449
msgid ""
"Stored: legacy XEP-0027/keyserver key is known, but is not currently active "
"for this contact."
msgstr ""
"מאוחסן: מפתח XEP-0027/שרת מפתח מדור קודם ידוע, אך אינו פעיל כעת עבור איש קשר"
" זה."

#: plugins/openpgp/src/contact_details_provider.vala:451
msgid "Inactive: no legacy XEP-0027/keyserver key is stored."
msgstr "לא פעיל: לא מאוחסן מפתח XEP-0027/שרת מפתח מדור קודם."

#: plugins/openpgp/src/contact_details_provider.vala:457
msgid "Verified: XMPP-published OpenPGP key is stored and manually verified."
msgstr "מאומת: מפתח OpenPGP שפורסם דרך XMPP מאוחסן ומאומת באופן ידני."

#: plugins/openpgp/src/contact_details_provider.vala:460
msgid ""
"Changed: XMPP-published OpenPGP key differs from the previously verified "
"key. Verify the fingerprint before trusting this identity."
msgstr ""
"השתנה: מפתח OpenPGP שפורסם דרך XMPP שונה מהמפתח שאומת קודם לכן. אמת את טביעת"
" האצבע לפני שאתה נותן אמון בזהות הזו."

#: plugins/openpgp/src/contact_details_provider.vala:462
msgid ""
"Unverified: XMPP-published OpenPGP key is stored. Compare the fingerprint "
"before trusting this identity."
msgstr ""
"לא מאומת: מפתח OpenPGP שפורסם דרך XMPP מאוחסן. השווה את טביעת האצבע לפני "
"שאתה סומך על זהות זו."

#: plugins/openpgp/src/contact_details_provider.vala:465
msgid ""
"Supported: contact advertises OpenPGP for XMPP, but no retrievable XMPP-"
"published key is stored."
msgstr ""
"נתמך: איש הקשר מצהיר על תמיכה ב־OpenPGP for XMPP, אך לא נשמר מפתח שניתן "
"לאחזר דרך XMPP."

#: plugins/openpgp/src/contact_details_provider.vala:467
msgid "Inactive: no OpenPGP-for-XMPP support or XMPP-published key is known."
msgstr "לא פעיל: לא ידועה תמיכה ב־OpenPGP for XMPP או מפתח שפורסם דרך XMPP."

#: plugins/openpgp/src/contact_details_provider.vala:497
msgid "Fingerprint copied"
msgstr "טביעת אצבע הועתקה"

#: plugins/openpgp/src/contact_details_provider.vala:520
msgid "Verifying OpenPGP-for-XMPP key..."
msgstr "מאמת מפתח OpenPGP for XMPP…"

#: plugins/openpgp/src/contact_details_provider.vala:554
msgid ""
"Cannot verify: key is not in the keyring or has no matching xmpp: user ID."
msgstr ""
"אי אפשר לאמת: המפתח אינו בצרור המפתחות או שאין לו מזהה משתמש xmpp: תואם."

#: plugins/openpgp/src/contact_details_provider.vala:611
msgid "Searching keyserver with fingerprint: "
msgstr "מחפש בשרת המפתחות לפי טביעת אצבע: "

#: plugins/openpgp/src/contact_details_provider.vala:626
msgid ""
"Key not found or has no verified email on keyserver.\n"
"Ask the contact to verify their email on keys.openpgp.org\n"
"or send you their public key file directly."
msgstr ""
"המפתח לא נמצא, או שכתובת הדוא״ל שלו לא אומתה בשרת המפתחות.\n"
"יש לבקש מאיש הקשר לאמת את כתובתו ב־keys.openpgp.org\n"
"או לשלוח לך את קובץ המפתח הציבורי ישירות."

#: plugins/openpgp/src/contact_details_provider.vala:628
msgid "Failed: "
msgstr "נכשל: "

#: plugins/openpgp/src/contact_details_provider.vala:636
msgid "Searching keyserver with JID..."
msgstr "מחפש בשרת המפתחות לפי JID…"

#: plugins/openpgp/src/contact_details_provider.vala:657
msgid "Not found with JID. Enter email address:"
msgstr "לא נמצא עם JID. הזן כתובת אימייל:"

#: plugins/openpgp/src/contact_details_provider.vala:668
msgid "Enter Email Address"
msgstr "הזן כתובת אימייל"

#: plugins/openpgp/src/contact_details_provider.vala:669
msgid ""
"The key was not found using the JID.\n"
"\n"
"Enter the email address that is in the contact's OpenPGP key:"
msgstr ""
"המפתח לא נמצא באמצעות JID.\n"
"\n"
"הכנס את כתובת הדוא\"ל שנמצאת במפתח OpenPGP של איש הקשר:"

#: plugins/openpgp/src/contact_details_provider.vala:671
#: plugins/openpgp/src/key_management_dialog.vala:1045
#: plugins/openpgp/src/key_management_dialog.vala:1486
#: plugins/openpgp/src/key_management_dialog.vala:1654
#: plugins/openpgp/src/key_management_dialog.vala:1694
#: plugins/openpgp/src/key_management_dialog.vala:1789
#: plugins/openpgp/src/key_management_dialog.vala:1924
#: plugins/openpgp/src/key_management_dialog.vala:2108
#: plugins/openpgp/src/key_management_dialog.vala:2270
#: plugins/openpgp/src/key_management_dialog.vala:2866
#: plugins/openpgp/src/key_management_dialog.vala:3211
#: plugins/openpgp/src/key_management_dialog.vala:3213
#: plugins/openpgp/src/plugin.vala:453
msgid "Cancel"
msgstr "בטל"

#: plugins/openpgp/src/contact_details_provider.vala:672
msgid "Search"
msgstr "חפש"

#: plugins/openpgp/src/contact_details_provider.vala:709
msgid "Searching keyserver for: "
msgstr "מחפש שרת מפתחות עבור: "

#: plugins/openpgp/src/contact_details_provider.vala:719
msgid "Not found: "
msgstr "לא נמצא: "

#: plugins/openpgp/src/encryption_list_entry.vala:66
msgid "No conversation selected."
msgstr "לא נבחרה שיחה."

#: plugins/openpgp/src/encryption_list_entry.vala:75
msgid ""
"You didn't configure OpenPGP for this account. You can do that in the "
"Accounts Dialog."
msgstr ""
"לא הגדרת את OpenPGP עבור חשבון זה. אתה יכול לעשות זאת בתיבת הדו-שיח חשבונות."

#: plugins/openpgp/src/encryption_list_entry.vala:113
#: plugins/openpgp/src/encryption_list_entry.vala:240
msgid "OpenPGP manager not available."
msgstr "מנהל OpenPGP אינו זמין."

#: plugins/openpgp/src/encryption_list_entry.vala:121
msgid "OpenPGP-for-XMPP key manager not available."
msgstr "מנהל מפתחות OpenPGP-for-XMPP אינו זמין."

#: plugins/openpgp/src/encryption_list_entry.vala:129
msgid "Checking OpenPGP key via PubSub..."
msgstr "בודק מפתח OpenPGP באמצעות PubSub..."

#: plugins/openpgp/src/encryption_list_entry.vala:138
msgid ""
"Checking the OpenPGP-for-XMPP key via PubSub timed out. Try again, or switch"
" to legacy XEP-0027 if the contact has a keyserver key."
msgstr ""
"הזמן המוקצב לבדיקת מפתח OpenPGP for XMPP דרך PubSub חלף. יש לנסות שוב, או "
"לעבור ל־XEP-0027 הוותיק אם לאיש הקשר יש מפתח בשרת מפתחות."

#: plugins/openpgp/src/encryption_list_entry.vala:150
msgid ""
"This contact's OpenPGP-for-XMPP key has not been refreshed yet. Try again "
"after the contact republishes it, or use the refresh button in contact "
"details."
msgstr ""
"המפתח OpenPGP-for-XMPP של איש קשר זה עדיין לא רענן. נסה שוב לאחר שאיש הקשר "
"יפרסם אותו מחדש, או השתמש בלחצן הרענון בפרטי איש הקשר."

#: plugins/openpgp/src/encryption_list_entry.vala:159
#: plugins/openpgp/src/encryption_list_entry.vala:215
msgid ""
"This contact has no legacy OpenPGP/XEP-0027 key. Switch your OpenPGP key "
"usage to DinoX / OpenPGP for XMPP."
msgstr ""
"לאיש קשר זה אין מפתח OpenPGP/XEP-0027 מדור קודם. החלף את השימוש במפתח "
"OpenPGP שלך ל-DinoX / OpenPGP עבור XMPP."

#: plugins/openpgp/src/encryption_list_entry.vala:161
#: plugins/openpgp/src/encryption_list_entry.vala:211
msgid ""
"This contact has no OpenPGP-for-XMPP key. Switch to a legacy XEP-0027 key or"
" ask the contact to publish an OpenPGP-for-XMPP key."
msgstr ""
"לאיש קשר זה אין מפתח OpenPGP-for-XMPP. עבור למפתח XEP-0027 מדור קודם או בקש "
"מאיש הקשר לפרסם מפתח OpenPGP-עבור-XMPP."

#: plugins/openpgp/src/encryption_list_entry.vala:171
#: plugins/openpgp/src/manager.vala:1119
msgid ""
"This contact's OpenPGP-for-XMPP key changed. Verify the fingerprint in "
"contact details before sending."
msgstr ""
"מפתח OpenPGP-for-XMPP של איש קשר זה השתנה. אמת את טביעת האצבע בפרטי הקשר "
"לפני השליחה."

#: plugins/openpgp/src/encryption_list_entry.vala:172
#: plugins/openpgp/src/manager.vala:1120
msgid ""
"This contact's OpenPGP-for-XMPP key is not verified. Verify the fingerprint "
"in contact details before sending."
msgstr ""
"מפתח OpenPGP-for-XMPP של איש קשר זה אינו מאומת. אמת את טביעת האצבע בפרטי "
"הקשר לפני השליחה."

#: plugins/openpgp/src/encryption_list_entry.vala:180
#: plugins/openpgp/src/encryption_list_entry.vala:219
#: plugins/openpgp/src/manager.vala:429
msgid ""
"This contact has a stored legacy OpenPGP/XEP-0027 key, but it is not "
"currently active."
msgstr ""
"לאיש קשר זה יש מפתח OpenPGP/XEP-0027 מדור קודם מאוחסן, אך הוא אינו פעיל כעת."

#: plugins/openpgp/src/encryption_list_entry.vala:200
msgid "This contact's OpenPGP key is not in your keyring."
msgstr "מפתח OpenPGP של איש קשר זה אינו נמצא בצרור המפתחות שלך."

#: plugins/openpgp/src/encryption_list_entry.vala:229
msgid "Legacy OpenPGP (XEP-0027/keyserver) is active for outgoing messages."
msgstr "מדור קודם OpenPGP (XEP-0027/שרת מפתח) פעיל עבור הודעות יוצאות."

#: plugins/openpgp/src/encryption_list_entry.vala:231
msgid "OpenPGP for XMPP (XEP-0373/0374) is active for outgoing messages."
msgstr "OpenPGP עבור XMPP (XEP-0373/0374) פעיל עבור הודעות יוצאות."

#: plugins/openpgp/src/encryption_list_entry.vala:249
#, c-format
msgid "A member's OpenPGP key is not configured: %s"
msgstr "מפתח OpenPGP של חבר אינו מוגדר: %s"

#: plugins/openpgp/src/encryption_list_entry.vala:285
#, c-format
msgid "A member's OpenPGP key is not in your keyring: %s"
msgstr "מפתח OpenPGP של חבר אינו נמצא בצרור המפתחות שלך: %s"

#: plugins/openpgp/src/encryption_preferences_entry.vala:51
msgid "Loading keys..."
msgstr "טוען מפתחות..."

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
#: plugins/openpgp/src/encryption_preferences_entry.vala:127
#: plugins/openpgp/src/encryption_preferences_entry.vala:157
msgid "Outgoing OpenPGP messages"
msgstr "הודעות OpenPGP יוצאות"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
msgid "Error in GnuPG"
msgstr "שגיאה ב-GnuPG"

#: plugins/openpgp/src/encryption_preferences_entry.vala:127
msgid "No keys available. Generate or import one!"
msgstr "אין מפתחות זמינים. צור או ייבא אחד!"

#: plugins/openpgp/src/encryption_preferences_entry.vala:159
msgid ""
"DinoX currently sends OpenPGP as legacy XEP-0027 using keyserver/contact "
"keys."
msgstr ""
"DinoX שולח כרגע את OpenPGP בתור XEP-0027 מדור קודם באמצעות מפתחות שרת "
"מפתח/איש קשר."

#: plugins/openpgp/src/encryption_preferences_entry.vala:162
msgid "DinoX currently sends OpenPGP for XMPP using XEP-0373/0374."
msgstr "DinoX שולח כעת OpenPGP עבור XMPP באמצעות XEP-0373/0374."

#: plugins/openpgp/src/encryption_preferences_entry.vala:165
msgid "No OpenPGP send key is active for this account."
msgstr "שום מפתח שליחה OpenPGP לא פעיל עבור חשבון זה."

#: plugins/openpgp/src/encryption_preferences_entry.vala:229
msgid "Manage Keys"
msgstr "נהל מפתחות"

#: plugins/openpgp/src/encryption_preferences_entry.vala:230
msgid "Generate, import, export, or delete keys"
msgstr "צור, ייבא, ייצא או מחק מפתחות"

#: plugins/openpgp/src/key_management_dialog.vala:171
msgid "OpenPGP Key Management"
msgstr "ניהול מפתחות OpenPGP"

#: plugins/openpgp/src/key_management_dialog.vala:197
msgid "Actions"
msgstr "פעולות"

#: plugins/openpgp/src/key_management_dialog.vala:199
#, c-format
msgid "Keys and server backups for %s"
msgstr "מפתחות וגיבויים בשרת עבור %s"

#: plugins/openpgp/src/key_management_dialog.vala:204
msgid "Generate New Key"
msgstr "צור מפתח חדש"

#: plugins/openpgp/src/key_management_dialog.vala:205
msgid "Create a new OpenPGP key pair"
msgstr "צור זוג מפתחות חדש של OpenPGP"

#: plugins/openpgp/src/key_management_dialog.vala:222
msgid "Import Key"
msgstr "ייבא מפתח"

#: plugins/openpgp/src/key_management_dialog.vala:223
msgid ""
"Import a private key for this account or a public key from a contact. "
"Importing does not activate a key."
msgstr ""
"ייבא מפתח פרטי לחשבון זה או מפתח ציבורי מאיש קשר. הייבוא אינו מפעיל מפתח."

#: plugins/openpgp/src/key_management_dialog.vala:240
#: plugins/openpgp/src/key_management_dialog.vala:1655
msgid "Delete Server Backup"
msgstr "מחק את גיבוי השרת"

#: plugins/openpgp/src/key_management_dialog.vala:241
msgid ""
"Remove this account's encrypted private-key backup. Local keys and public-"
"key publications are kept."
msgstr ""
"הסר את הגיבוי המוצפן של המפתח הפרטי של חשבון זה. מפתחות מקומיים ופרסומי מפתח"
" ציבורי נשמרים."

#: plugins/openpgp/src/key_management_dialog.vala:247
msgid "Fetch Key from Server (Sync)"
msgstr "אחזר מפתח משרת (סנכרון)"

#: plugins/openpgp/src/key_management_dialog.vala:248
msgid "Import your secret key backup from your server"
msgstr "ייבא את גיבוי המפתח הסודי שלך מהשרת שלך"

#: plugins/openpgp/src/key_management_dialog.vala:290
msgid "Your Keys"
msgstr "המפתחות שלך"

#: plugins/openpgp/src/key_management_dialog.vala:291
msgid "Private keys available for signing and decryption"
msgstr "מפתחות פרטיים זמינים לחתימה ולפענוח"

#: plugins/openpgp/src/key_management_dialog.vala:386
#: plugins/openpgp/src/key_management_dialog.vala:400
#: plugins/openpgp/src/key_management_dialog.vala:456
msgid "GnuPG did not respond."
msgstr "GnuPG לא הגיב."

#: plugins/openpgp/src/key_management_dialog.vala:412
msgid "Server Backup Cleanup Pending"
msgstr "ניקוי גיבוי שרת בהמתנה"

#: plugins/openpgp/src/key_management_dialog.vala:413
msgid ""
"The key was kept locally. DinoX will retry removing its matching backup when"
" this account reconnects. Then retry revoking the key."
msgstr ""
"המפתח נשמר מקומית. DinoX ינסה שוב להסיר את הגיבוי התואם כשהחשבון יתחבר מחדש."
" לאחר מכן אפשר לנסות שוב לבטל את המפתח."

#: plugins/openpgp/src/key_management_dialog.vala:455
msgid "Could not load OpenPGP keys"
msgstr "לא ניתן לטעון מפתחות OpenPGP"

#: plugins/openpgp/src/key_management_dialog.vala:470
msgid "No private keys found"
msgstr "לא נמצאו מפתחות פרטיים"

#: plugins/openpgp/src/key_management_dialog.vala:471
msgid "Generate or import a key to get started"
msgstr "צור או ייבא מפתח כדי להתחיל"

#: plugins/openpgp/src/key_management_dialog.vala:646
msgid "Published to keyserver"
msgstr "פורסם לשרת מפתח"

#: plugins/openpgp/src/key_management_dialog.vala:652
msgid "Active legacy and XMPP account key"
msgstr "מפתח פעיל לחשבון במצב הוותיק וב־XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active legacy XEP-0027 account key"
msgstr "מפתח חשבון XEP-0027 פעיל מדור קודם"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active XMPP account key"
msgstr "מפתח חשבון XMPP פעיל"

#: plugins/openpgp/src/key_management_dialog.vala:659
msgid "Fingerprint"
msgstr "טביעת אצבע"

#: plugins/openpgp/src/key_management_dialog.vala:672
msgid "Remove Assignment to This Account"
msgstr "הסר שיוך לחשבון זה"

#: plugins/openpgp/src/key_management_dialog.vala:673
msgid ""
"Keep the key in DinoX's keyring and remove only its manual assignment to "
"this account."
msgstr ""
"שמור את המפתח בצרור המפתחות של DinoX והסר רק את ההקצאה הידנית שלו לחשבון זה."

#: plugins/openpgp/src/key_management_dialog.vala:684
msgid "OpenPGP for XMPP (XEP-0373/0374)"
msgstr "OpenPGP עבור XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/key_management_dialog.vala:686
msgid ""
"Active for this account. DinoX publishes this key through XMPP for OpenPGP-"
