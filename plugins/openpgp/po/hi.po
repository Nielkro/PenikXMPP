msgstr "XMPP पता"

#: plugins/openpgp/src/key_management_dialog.vala:995
#: plugins/openpgp/src/key_management_dialog.vala:1025
msgid "xmpp@example.com"
msgstr "xmpp@example.com"

#: plugins/openpgp/src/key_management_dialog.vala:1001
#: plugins/openpgp/src/key_management_dialog.vala:1029
msgid ""
"This key will be selected for this DinoX account and published through XMPP "
"for OpenPGP-for-XMPP capable clients."
msgstr ""
"यह कुंजी इस DinoX खाते के लिए चुनी जाएगी और XMPP के लिए OpenPGP समर्थित "
"क्लाइंट के लिए XMPP से प्रकाशित होगी।"

#: plugins/openpgp/src/key_management_dialog.vala:1009
msgid "Passphrase (optional)"
msgstr "पासफ़्रेज़ (वैकल्पिक)"

#: plugins/openpgp/src/key_management_dialog.vala:1020
msgid "Email address"
msgstr "ईमेल पता"

#: plugins/openpgp/src/key_management_dialog.vala:1021
msgid "name@example.com"
msgstr "name@example.com"

#: plugins/openpgp/src/key_management_dialog.vala:1022
msgid ""
"Use a mailbox you can access. keys.openpgp.org requires email verification "
"before older XEP-0027 clients can find this key."
msgstr ""
"ऐसा मेलबॉक्स इस्तेमाल करें जिसे आप खोल सकते हों। पुराने XEP-0027 क्लाइंट "
"कुंजी खोज सकें, इसके लिए keys.openpgp.org पर ईमेल सत्यापन ज़रूरी है।"

#: plugins/openpgp/src/key_management_dialog.vala:1038
msgid "4096-bit RSA key, valid for 2 years."
msgstr "4096-बिट RSA कुंजी, 2 साल के लिए मान्य।"

#: plugins/openpgp/src/key_management_dialog.vala:1046
msgid "Generate"
msgstr "बनाएं"

#: plugins/openpgp/src/key_management_dialog.vala:1059
#: plugins/openpgp/src/key_management_dialog.vala:1064
#: plugins/openpgp/src/key_management_dialog.vala:1071
