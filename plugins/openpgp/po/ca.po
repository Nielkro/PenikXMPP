msgstr "Necessària per restaurar la clau"

#: plugins/openpgp/src/key_management_dialog.vala:849
msgid "Revoke Key"
msgstr "Revoca la clau"

#: plugins/openpgp/src/key_management_dialog.vala:850
msgid "Invalidate key, keep locally for old messages"
msgstr "Invalida la clau i conserva-la localment per als missatges antics"

#: plugins/openpgp/src/key_management_dialog.vala:859
msgid "Revoke &amp; Delete Key"
msgstr "Revoca i suprimeix la clau"

#: plugins/openpgp/src/key_management_dialog.vala:860
msgid "Invalidate and remove key completely"
msgstr "Invalida i elimina completament la clau"

#: plugins/openpgp/src/key_management_dialog.vala:870
msgid "Delete Key"
msgstr "Suprimeix la clau"

#: plugins/openpgp/src/key_management_dialog.vala:871
