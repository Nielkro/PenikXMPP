msgid "Cancel"
msgstr "取消"

#: plugins/openpgp/src/contact_details_provider.vala:672
msgid "Search"
msgstr "搜尋"

#: plugins/openpgp/src/contact_details_provider.vala:709
msgid "Searching keyserver for: "
msgstr "正在搜尋金鑰伺服器："

#: plugins/openpgp/src/contact_details_provider.vala:719
msgid "Not found: "
msgstr "搵唔到："

#: plugins/openpgp/src/encryption_list_entry.vala:66
msgid "No conversation selected."
msgstr "仲未揀對話。"

#: plugins/openpgp/src/encryption_list_entry.vala:75
msgid ""
"You didn't configure OpenPGP for this account. You can do that in the "
"Accounts Dialog."
msgstr "你仲未為呢個帳戶設定 OpenPGP。可以去帳戶對話框設定。"

#: plugins/openpgp/src/encryption_list_entry.vala:113
#: plugins/openpgp/src/encryption_list_entry.vala:240
msgid "OpenPGP manager not available."
msgstr "OpenPGP 管理器不可用。"

#: plugins/openpgp/src/encryption_list_entry.vala:121
msgid "OpenPGP-for-XMPP key manager not available."
msgstr "OpenPGP for XMPP 金鑰管理器不可用。"

#: plugins/openpgp/src/encryption_list_entry.vala:129
msgid "Checking OpenPGP key via PubSub..."
msgstr "正在透過 PubSub 檢查 OpenPGP 金鑰…"

#: plugins/openpgp/src/encryption_list_entry.vala:138
msgid ""
"Checking the OpenPGP-for-XMPP key via PubSub timed out. Try again, or switch"
" to legacy XEP-0027 if the contact has a keyserver key."
msgstr ""
"經 PubSub 檢查 OpenPGP for XMPP 金鑰逾時。請再試；如果聯絡人有金鑰伺服器金鑰，亦可以切換到舊版 XEP-0027。"

#: plugins/openpgp/src/encryption_list_entry.vala:150
msgid ""
"This contact's OpenPGP-for-XMPP key has not been refreshed yet. Try again "
"after the contact republishes it, or use the refresh button in contact "
"details."
msgstr "呢位聯絡人嘅 OpenPGP for XMPP 金鑰仲未更新。請等佢重新發佈之後再試，或者用聯絡人詳情入面嘅重新整理按鈕。"

#: plugins/openpgp/src/encryption_list_entry.vala:159
#: plugins/openpgp/src/encryption_list_entry.vala:215
msgid ""
"This contact has no legacy OpenPGP/XEP-0027 key. Switch your OpenPGP key "
"usage to DinoX / OpenPGP for XMPP."
msgstr ""
"呢位聯絡人冇舊版 OpenPGP/XEP-0027 金鑰。請將你嘅 OpenPGP 金鑰用途切換到「DinoX / OpenPGP for XMPP」。"

#: plugins/openpgp/src/encryption_list_entry.vala:161
#: plugins/openpgp/src/encryption_list_entry.vala:211
msgid ""
"This contact has no OpenPGP-for-XMPP key. Switch to a legacy XEP-0027 key or"
" ask the contact to publish an OpenPGP-for-XMPP key."
msgstr ""
"呢位聯絡人冇 OpenPGP for XMPP 金鑰。請切換到舊版 XEP-0027 金鑰，或者叫佢發佈 OpenPGP for XMPP 金鑰。"

#: plugins/openpgp/src/encryption_list_entry.vala:171
#: plugins/openpgp/src/manager.vala:1119
msgid ""
"This contact's OpenPGP-for-XMPP key changed. Verify the fingerprint in "
"contact details before sending."
msgstr "呢位聯絡人嘅 OpenPGP for XMPP 金鑰改咗。傳送之前，請喺聯絡人詳情驗證指紋。"

#: plugins/openpgp/src/encryption_list_entry.vala:172
#: plugins/openpgp/src/manager.vala:1120
msgid ""
"This contact's OpenPGP-for-XMPP key is not verified. Verify the fingerprint "
"in contact details before sending."
msgstr "呢位聯絡人嘅 OpenPGP for XMPP 金鑰未驗證。傳送之前，請喺聯絡人詳情驗證指紋。"

#: plugins/openpgp/src/encryption_list_entry.vala:180
#: plugins/openpgp/src/encryption_list_entry.vala:219
#: plugins/openpgp/src/manager.vala:429
msgid ""
"This contact has a stored legacy OpenPGP/XEP-0027 key, but it is not "
"currently active."
msgstr "已儲存呢位聯絡人嘅舊版 OpenPGP/XEP-0027 金鑰，但目前未啟用。"

#: plugins/openpgp/src/encryption_list_entry.vala:200
msgid "This contact's OpenPGP key is not in your keyring."
msgstr "呢位聯絡人嘅 OpenPGP 金鑰唔喺你嘅金鑰環。"

#: plugins/openpgp/src/encryption_list_entry.vala:229
msgid "Legacy OpenPGP (XEP-0027/keyserver) is active for outgoing messages."
msgstr "傳送訊息已使用舊版 OpenPGP（XEP-0027/金鑰伺服器）。"

#: plugins/openpgp/src/encryption_list_entry.vala:231
msgid "OpenPGP for XMPP (XEP-0373/0374) is active for outgoing messages."
msgstr "傳送訊息已使用 OpenPGP for XMPP（XEP-0373/0374）。"

#: plugins/openpgp/src/encryption_list_entry.vala:249
#, c-format
msgid "A member's OpenPGP key is not configured: %s"
msgstr "有位成員仲未設定 OpenPGP 金鑰：%s"

#: plugins/openpgp/src/encryption_list_entry.vala:285
#, c-format
msgid "A member's OpenPGP key is not in your keyring: %s"
msgstr "有位成員嘅 OpenPGP 金鑰唔喺你嘅金鑰環：%s"

#: plugins/openpgp/src/encryption_preferences_entry.vala:51
msgid "Loading keys..."
msgstr "正在載入金鑰…"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
#: plugins/openpgp/src/encryption_preferences_entry.vala:127
#: plugins/openpgp/src/encryption_preferences_entry.vala:157
msgid "Outgoing OpenPGP messages"
msgstr "發出的 OpenPGP 訊息"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
msgid "Error in GnuPG"
msgstr "GnuPG 錯誤"

#: plugins/openpgp/src/encryption_preferences_entry.vala:127
msgid "No keys available. Generate or import one!"
msgstr "冇可用金鑰。請產生或者匯入一把！"

#: plugins/openpgp/src/encryption_preferences_entry.vala:159
msgid ""
"DinoX currently sends OpenPGP as legacy XEP-0027 using keyserver/contact "
"keys."
msgstr "DinoX 目前使用金鑰伺服器/聯絡人金鑰，透過舊版 XEP-0027 傳送 OpenPGP 訊息。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:162
msgid "DinoX currently sends OpenPGP for XMPP using XEP-0373/0374."
msgstr "DinoX 目前透過 XEP-0373/0374 傳送 OpenPGP for XMPP 訊息。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:165
msgid "No OpenPGP send key is active for this account."
msgstr "呢個帳戶冇啟用中嘅 OpenPGP 傳送金鑰。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:229
msgid "Manage Keys"
msgstr "管理金鑰"

#: plugins/openpgp/src/encryption_preferences_entry.vala:230
msgid "Generate, import, export, or delete keys"
msgstr "產生、匯入、匯出或刪除金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:171
msgid "OpenPGP Key Management"
msgstr "OpenPGP 金鑰管理"

#: plugins/openpgp/src/key_management_dialog.vala:197
msgid "Actions"
msgstr "操作"

#: plugins/openpgp/src/key_management_dialog.vala:199
#, c-format
msgid "Keys and server backups for %s"
msgstr "%s 嘅金鑰同伺服器備份"

#: plugins/openpgp/src/key_management_dialog.vala:204
msgid "Generate New Key"
msgstr "產生新金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:205
msgid "Create a new OpenPGP key pair"
msgstr "建立一個新的 OpenPGP 金鑰對"

#: plugins/openpgp/src/key_management_dialog.vala:222
msgid "Import Key"
msgstr "匯入金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:223
msgid ""
"Import a private key for this account or a public key from a contact. "
"Importing does not activate a key."
msgstr "匯入呢個帳戶嘅私鑰，或者聯絡人嘅公鑰。匯入唔會啟用金鑰。"

#: plugins/openpgp/src/key_management_dialog.vala:240
#: plugins/openpgp/src/key_management_dialog.vala:1655
msgid "Delete Server Backup"
msgstr "刪除伺服器備份"

#: plugins/openpgp/src/key_management_dialog.vala:241
msgid ""
"Remove this account's encrypted private-key backup. Local keys and public-"
"key publications are kept."
msgstr "移除呢個帳戶嘅加密私鑰備份。本機金鑰同已發佈嘅公鑰會保留。"

#: plugins/openpgp/src/key_management_dialog.vala:247
msgid "Fetch Key from Server (Sync)"
msgstr "從伺服器獲取金鑰（同步）"

#: plugins/openpgp/src/key_management_dialog.vala:248
msgid "Import your secret key backup from your server"
msgstr "由伺服器匯入你嘅私鑰備份"

#: plugins/openpgp/src/key_management_dialog.vala:290
msgid "Your Keys"
msgstr "你嘅金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:291
msgid "Private keys available for signing and decryption"
msgstr "可以用嚟簽署同解密嘅私鑰"

#: plugins/openpgp/src/key_management_dialog.vala:386
#: plugins/openpgp/src/key_management_dialog.vala:400
#: plugins/openpgp/src/key_management_dialog.vala:456
msgid "GnuPG did not respond."
msgstr "GnuPG 冇回應。"

#: plugins/openpgp/src/key_management_dialog.vala:412
msgid "Server Backup Cleanup Pending"
msgstr "伺服器備份待清理"

#: plugins/openpgp/src/key_management_dialog.vala:413
msgid ""
"The key was kept locally. DinoX will retry removing its matching backup when"
" this account reconnects. Then retry revoking the key."
msgstr "金鑰會保留喺本機。帳戶重新連線時，DinoX 會再試移除對應嘅備份。之後請再試撤銷金鑰。"

#: plugins/openpgp/src/key_management_dialog.vala:455
msgid "Could not load OpenPGP keys"
msgstr "無法載入 OpenPGP 金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:470
msgid "No private keys found"
msgstr "搵唔到私鑰"

#: plugins/openpgp/src/key_management_dialog.vala:471
msgid "Generate or import a key to get started"
msgstr "產生或匯入一個金鑰以開始"

#: plugins/openpgp/src/key_management_dialog.vala:646
msgid "Published to keyserver"
msgstr "已發佈到金鑰伺服器"

#: plugins/openpgp/src/key_management_dialog.vala:652
msgid "Active legacy and XMPP account key"
msgstr "已啟用的舊版及 XMPP 帳戶金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active legacy XEP-0027 account key"
msgstr "已啟用的舊版 XEP-0027 帳戶金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active XMPP account key"
msgstr "已啟用的 XMPP 帳戶金鑰"

#: plugins/openpgp/src/key_management_dialog.vala:659
msgid "Fingerprint"
msgstr "指紋"

#: plugins/openpgp/src/key_management_dialog.vala:672
msgid "Remove Assignment to This Account"
msgstr "取消指派畀呢個帳戶"

#: plugins/openpgp/src/key_management_dialog.vala:673
msgid ""
"Keep the key in DinoX's keyring and remove only its manual assignment to "
"this account."
msgstr "保留 DinoX 金鑰環入面嘅金鑰，只取消手動指派畀呢個帳戶。"

#: plugins/openpgp/src/key_management_dialog.vala:684
msgid "OpenPGP for XMPP (XEP-0373/0374)"
msgstr "OpenPGP for XMPP（XEP-0373/0374）"

#: plugins/openpgp/src/key_management_dialog.vala:686
msgid ""
"Active for this account. DinoX publishes this key through XMPP for OpenPGP-"
"capable clients."
msgstr "呢個帳戶已啟用。DinoX 會經 XMPP 發佈呢把金鑰，畀支援 OpenPGP 嘅客戶端使用。"

#: plugins/openpgp/src/key_management_dialog.vala:688
msgid ""
"Stored for OpenPGP for XMPP, but not active while legacy XEP-0027/keyserver "
"mode is selected."
msgstr "已儲存作 OpenPGP for XMPP 用途，但選擇舊版 XEP-0027／金鑰伺服器模式時唔會啟用。"

#: plugins/openpgp/src/key_management_dialog.vala:690
msgid ""
"Inactive. This key is currently selected for legacy XEP-0027/keyserver use."
msgstr "未啟用。呢把金鑰目前選作舊版 XEP-0027／金鑰伺服器用途。"

#: plugins/openpgp/src/key_management_dialog.vala:692
msgid ""
"Not available for this account. OpenPGP for XMPP keys must contain an xmpp: "
"user ID for this XMPP address."
msgstr "呢個帳戶用唔到。OpenPGP for XMPP 金鑰必須包含對應呢個 XMPP 地址嘅 xmpp: 用戶 ID。"

#: plugins/openpgp/src/key_management_dialog.vala:694
msgid ""
"Not active for this account. Select it below to publish it through XMPP."
msgstr "呢個帳戶未啟用。請喺下面選取，再經 XMPP 發佈。"

#: plugins/openpgp/src/key_management_dialog.vala:702
msgid "Selected for OpenPGP for XMPP"
msgstr "已選擇用於 OpenPGP for XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:703
msgid "Use for OpenPGP for XMPP"
msgstr "用於 OpenPGP for XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:705
msgid ""
"DinoX uses this key for XEP-0373/0374 messages and publishes it through "
"XMPP."
msgstr "DinoX 用呢把金鑰傳送 XEP-0373/0374 訊息，並經 XMPP 發佈佢。"

#: plugins/openpgp/src/key_management_dialog.vala:708
msgid ""
"Selects this key for XEP-0373/0374 messages and publishes it through XMPP."
msgstr "選擇呢把金鑰嚟傳送 XEP-0373/0374 訊息，並經 XMPP 發佈佢。"

#: plugins/openpgp/src/key_management_dialog.vala:715
