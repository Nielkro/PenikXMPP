msgstr "正在加载密钥…"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
#: plugins/openpgp/src/encryption_preferences_entry.vala:127
#: plugins/openpgp/src/encryption_preferences_entry.vala:157
msgid "Outgoing OpenPGP messages"
msgstr "发出的 OpenPGP 消息"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
msgid "Error in GnuPG"
msgstr "GnuPG 错误"

#: plugins/openpgp/src/encryption_preferences_entry.vala:127
msgid "No keys available. Generate or import one!"
msgstr "无可用密钥。请生成或导入一个！"

#: plugins/openpgp/src/encryption_preferences_entry.vala:159
msgid ""
"DinoX currently sends OpenPGP as legacy XEP-0027 using keyserver/contact "
"keys."
msgstr "DinoX 当前使用密钥服务器/联系人密钥，通过旧版 XEP-0027 发送 OpenPGP 消息。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:162
msgid "DinoX currently sends OpenPGP for XMPP using XEP-0373/0374."
msgstr "DinoX 当前通过 XEP-0373/0374 发送 OpenPGP for XMPP 消息。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:165
msgid "No OpenPGP send key is active for this account."
msgstr "此账号没有已启用的 OpenPGP 发送密钥。"

#: plugins/openpgp/src/encryption_preferences_entry.vala:229
msgid "Manage Keys"
msgstr "管理密钥"

#: plugins/openpgp/src/encryption_preferences_entry.vala:230
