#: plugins/openpgp/src/key_management_dialog.vala:2980
#: plugins/openpgp/src/key_management_dialog.vala:3049
msgid "There is no secret key backup stored on the server for this account."
msgstr "এই অ্যাকাউন্টের জন্য সার্ভারে কোনো গোপন কী ব্যাকআপ সংরক্ষিত নেই।"

#: plugins/openpgp/src/key_management_dialog.vala:3003
msgid "GnuPG did not respond while checking the server key data."
