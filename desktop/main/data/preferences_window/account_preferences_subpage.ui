<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="DinoUiAccountPreferencesSubpage">
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwHeaderBar" id="headerbar">
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>
            <child>
              <object class="AdwClamp">
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">24</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="spacing">24</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkOverlay">
                        <property name="halign">center</property>
                        <property name="child">
                          <object class="DinoUiAvatarPicture" id="avatar">
                            <property name="height-request">144</property>
                            <property name="width-request">144</property>
                          </object>
                        </property>
                        <child type="overlay">
                          <object class="GtkBox" id="avatar_menu_box">
                            <property name="opacity">0.9</property>
                            <property name="margin-end">6</property>
                            <property name="margin-bottom">6</property>
                            <property name="halign">end</property>
                            <property name="valign">end</property>
                            <style>
                              <class name="card"/>
                              <class name="toolbar"/>
                              <class name="compact-card-toolbar"/>
                            </style>
                            <child>
                              <object class="GtkButton" id="edit_avatar_button">
                                <property name="icon-name">document-edit-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="remove_avatar_button">
                                <property name="icon-name">user-trash-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow" id="xmpp_address">
                            <property name="title" translatable="yes">XMPP Address</property>
                            <property name="subtitle_selectable">True</property>
                            <style>
                              <class name="property"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="local_alias">
                            <property name="title" translatable="yes">Local alias</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="password_change">
                            <property name="title" translatable="yes">Password</property>
                            <child type="suffix">
                              <object class="GtkBox">
                                <property name="opacity">0.7</property>
                                <property name="spacing">6</property>
                                <property name="orientation">horizontal</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">•••••</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">go-next-symbolic</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="timezone_row">
                            <property name="title" translatable="yes">Timezone (XEP-0202)</property>
                            <property name="subtitle" translatable="yes">Send to contacts so they know your local time</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="connection_status">
                            <property name="title" translatable="yes">Connection status</property>
                            <style>
                              <class name="property"/>
                            </style>
                            <child type="suffix">
                              <object class="GtkButton" id="enter_password_button">
                                <property name="label" translatable="yes">Enter password</property>
                                <property name="valign">center</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkButton" id="trust_certificate_button">
                                <property name="label" translatable="yes">View Certificate</property>
                                <property name="valign">center</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="login_protection_group">
                        <property name="title" translatable="yes">Login protection (MITM)</property>
                        <property name="description" translatable="yes">Changing the selection reconnects this account and checks the result immediately.</property>
                        <child>
                          <object class="AdwActionRow" id="login_protection_server">
                            <property name="title" translatable="yes">Server support</property>
                            <property name="use-markup">False</property>
                            <child type="suffix">
                              <object class="GtkSpinner" id="login_protection_spinner">
                                <property name="valign">center</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkImage" id="login_protection_icon">
                                <property name="icon-name">dialog-question-symbolic</property>
                                <property name="pixel-size">24</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="login_protection_mode">
                            <property name="title" translatable="yes">Extra login protection (MITM)</property>
                            <property name="use-subtitle">True</property>
                            <property name="use-markup">False</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Use when available</item>
                                  <item translatable="yes">Require for sign-in</item>
                                </items>
                              </object>
                            </property>
                            <property name="sensitive">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="login_protection_feedback">
                            <property name="visible">False</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Check availability</property>
                            <property name="subtitle" translatable="yes">Reconnects only this account.</property>
                            <child type="suffix">
                              <object class="GtkButton" id="login_protection_check">
                                <property name="label" translatable="yes">Check now</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="login_protection_reset_row">
                            <property name="title" translatable="yes">Allow sign-in without extra protection</property>
                            <property name="subtitle" translatable="yes">Removes the saved requirement for this account and reconnects. TLS encryption remains required.</property>
                            <property name="visible">False</property>
                            <child type="suffix">
                              <object class="GtkButton" id="login_protection_reset">
                                <property name="label" translatable="yes">Allow</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="login_protection_status">
                            <property name="title" translatable="yes">Current connection</property>
                            <property name="subtitle" translatable="yes">Login protection will be checked when this account connects.</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="dns_security_group">
                        <property name="title" translatable="yes">Connection security</property>
                        <property name="description" translatable="yes">DNSSEC and DANE authenticate this account's server connection. They do not change OMEMO or OpenPGP message encryption.</property>
                        <child>
                          <object class="AdwComboRow" id="dns_security_mode">
                            <property name="title" translatable="yes">DNSSEC and DANE</property>
                            <property name="use-subtitle">True</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="dns_security_help">
                            <property name="title" translatable="yes">How this mode works</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="dns_security_resolver">
                            <property name="title" translatable="yes">HTTPS DNS resolver URL</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="dns_security_status">
                            <property name="title" translatable="yes">Verification status</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Apply to this account</property>
                            <property name="subtitle" translatable="yes">Saves both settings and reconnects this account if enabled. Leave the resolver empty to use system DNS directly; Tor and SOCKS5 require an HTTPS resolver through the proxy.</property>
                            <child type="suffix">
                              <object class="GtkButton" id="dns_security_apply">
                                <property name="label" translatable="yes">Apply</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="cert_group">
                        <property name="title" translatable="yes">Server Certificate</property>
                        <property name="description" translatable="yes">TLS certificate used by the XMPP server</property>
                        <property name="visible">False</property>
                        <child>
                          <object class="AdwActionRow" id="cert_status_row">
                            <property name="title" translatable="yes">Status</property>
                            <style>
                              <class name="property"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="cert_issuer_row">
                            <property name="title" translatable="yes">Issued by</property>
                            <property name="visible">False</property>
                            <style>
                              <class name="property"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="cert_validity_row">
                            <property name="title" translatable="yes">Valid</property>
                            <property name="visible">False</property>
                            <style>
                              <class name="property"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="cert_fingerprint_row">
                            <property name="title" translatable="yes">SHA-256 Fingerprint</property>
                            <property name="visible">False</property>
                            <property name="subtitle_selectable">True</property>
                            <style>
                              <class name="property"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="unpin_certificate_button">
                            <property name="label" translatable="yes">Remove Pinned Certificate</property>
                            <property name="halign">end</property>
                            <property name="margin-top">6</property>
                            <property name="visible">False</property>
                            <style>
                              <class name="destructive-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="profile_group">
                        <property name="title" translatable="yes">Public Profile</property>
                        <property name="description" translatable="yes">Personal details are included in the legacy profile only when public access is enabled. Your profile picture keeps its existing visibility.</property>
                        <child>
                          <object class="AdwActionRow" id="profile_status_row">
                            <property name="visible">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow" id="vcard_public_access">
                            <property name="title" translatable="yes">Public Access</property>
                            <property name="subtitle" translatable="yes">Allow anyone to see your profile</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow" id="vcard_share_with_contacts">
                            <property name="title" translatable="yes">Share with Contacts</property>
                            <property name="subtitle" translatable="yes">Allow contacts to see your profile</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_fn">
                            <property name="title" translatable="yes">Full Name</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_nickname">
                            <property name="title" translatable="yes">Nickname</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="vcard_gender">
                            <property name="title" translatable="yes">Gender</property>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Unknown</item>
                                  <item translatable="yes">Male</item>
                                  <item translatable="yes">Female</item>
                                  <item translatable="yes">Other</item>
                                  <item translatable="yes">None</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_bday">
                            <property name="title" translatable="yes">Birthday</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwExpanderRow" id="vcard_address_expander">
                            <property name="title" translatable="yes">Address</property>
                            <child>
                              <object class="AdwEntryRow" id="vcard_adr_street">
                                <property name="title" translatable="yes">Street</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="vcard_adr_pcode">
                                <property name="title" translatable="yes">Postal Code</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="vcard_adr_city">
                                <property name="title" translatable="yes">City</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="vcard_adr_region">
                                <property name="title" translatable="yes">Region</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="vcard_adr_country">
                                <property name="title" translatable="yes">Country</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_email">
                            <property name="title" translatable="yes">Email</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_impp">
                            <property name="title" translatable="yes">IM Address</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_phone">
                            <property name="title" translatable="yes">Phone Number</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_org">
                            <property name="title" translatable="yes">Organization</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_title">
                            <property name="title" translatable="yes">Job Title</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_role">
                            <property name="title" translatable="yes">Role</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_tz">
                            <property name="title" translatable="yes">Timezone</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_url">
                            <property name="title" translatable="yes">Website</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="vcard_desc">
                            <property name="title" translatable="yes">Description</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="save_vcard_button">
                            <property name="label" translatable="yes">Save Profile</property>
                            <property name="halign">end</property>
                            <property name="margin-top">12</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Advanced Settings</property>
                        <property name="description" translatable="yes">Custom server connection (leave empty for automatic)</property>
                        <child>
                          <object class="AdwEntryRow" id="custom_host_entry">
                            <property name="title" translatable="yes">Server Hostname</property>
                          </object>
                        </child>
                        <child>                          <object class="AdwEntryRow" id="custom_port_entry">
                            <property name="title" translatable="yes">Port</property>
                            <property name="input-purpose">digits</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow" id="allow_plain_switch">
                            <property name="title" translatable="yes">Allow password login (PLAIN)</property>
                            <property name="subtitle" translatable="yes">Only for servers without SCRAM. Sends your password inside the TLS connection. Disabled by default.</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="proxy_group">
                        <property name="title" translatable="yes">SOCKS5 Proxy</property>
                        <child>
                          <object class="AdwSwitchRow" id="proxy_enable_row">
                            <property name="title" translatable="yes">Enable SOCKS5 Proxy</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="proxy_host_entry">
                            <property name="title" translatable="yes">Proxy Hostname</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="proxy_port_entry">
                            <property name="title" translatable="yes">Proxy Port</property>
                            <property name="input-purpose">digits</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwEntryRow" id="proxy_user_entry">
                            <property name="title" translatable="yes">Proxy Username (optional)</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPasswordEntryRow" id="proxy_pass_entry">
                            <property name="title" translatable="yes">Proxy Password (optional)</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="proxy_status_row">
                            <property name="title" translatable="yes">Proxy Status</property>
                            <property name="subtitle" translatable="yes">Not configured</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Botmother</property>
                        <child>
                          <object class="AdwActionRow" id="manage_botmothers_row">
                            <property name="title" translatable="yes">Manage Botmothers</property>
                            <property name="subtitle" translatable="yes">Create, configure and delete Botmothers for this account</property>
                            <property name="activatable">True</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">go-next-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">MQTT Bot (Account)</property>
                        <child>
                          <object class="AdwActionRow" id="manage_mqtt_bot_row">
                            <property name="title" translatable="yes">Manage Account MQTT Bot</property>
                            <property name="subtitle" translatable="yes">Topics, Publish Presets, Alerts and Bridges for this account's MQTT connection (separate from Standalone MQTT)</property>
                            <property name="activatable">True</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">go-next-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="button_container">
                        <property name="halign">center</property>
                        <property name="spacing">24</property>
                        <child>
                          <object class="GtkButton" id="disable_account_button">
                            <property name="label" translatable="yes">Disable account</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="remove_account_button">
                            <property name="label" translatable="yes">Remove account</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="pill"/>
                              <class name="destructive-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
