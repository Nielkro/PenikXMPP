#: plugins/mqtt/src/dns_security_group.vala:14
msgid ""
"These settings apply only to this MQTT broker, independently of XMPP "
"accounts."
msgstr "הגדרות אלו חלות רק על ברוקר MQTT זה, ללא תלות בחשבונות XMPP."

#: plugins/mqtt/src/dns_security_group.vala:24
msgid "HTTPS DNS resolver"
msgstr "פותר DNS HTTPS"

#: plugins/mqtt/src/dns_security_group.vala:28
msgid "DNS queries"
msgstr "שאילתות DNS"

#: plugins/mqtt/src/dns_security_group.vala:30
msgid ""
"Standalone MQTT connects directly. Leave the resolver empty to use system "
"DNS. Account proxy settings do not apply here."
msgstr ""
"MQTT עצמאי מתחבר ישירות. אפשר להשאיר את שדה פותר ה־DNS ריק כדי להשתמש ב־DNS "
"של המערכת. הגדרות השרת המתווך של החשבון אינן חלות כאן."

#: plugins/mqtt/src/dns_security_group.vala:31
msgid ""
"Leave the resolver empty to use system DNS directly. Tor and SOCKS5 require "
"an HTTPS resolver through the account's proxy."
msgstr ""
"השאר את הפותר ריק כדי להשתמש ישירות ב-DNS של המערכת. Tor ו-SOCKS5 דורשים "
"פותר HTTPS דרך ה-proxy של החשבון."

#: plugins/mqtt/src/dns_security_group.vala:44
msgid "Uses the existing TLS certificate verification."
msgstr "משתמש באימות תעודת TLS הקיים."

#: plugins/mqtt/src/dns_security_group.vala:45
msgid ""
"Checks DNSSEC and uses DANE when the broker supports it. DNS errors stop the"
" connection. Local addresses use ordinary TLS."
msgstr ""
"בדיקת DNSSEC ושימוש ב־DANE כשהשרת תומך בכך. שגיאות DNS עוצרות את החיבור. "
"לכתובות מקומיות משמש TLS רגיל."

#: plugins/mqtt/src/dns_security_group.vala:46
msgid ""
"Connects only with valid DNSSEC and DANE. Requires TLS and a public broker "
"domain."
msgstr ""
"התחברות רק עם DNSSEC ו־DANE תקינים. נדרשים TLS ושם דומיין ציבורי של השרת."

#: plugins/mqtt/src/dns_security_group.vala:59
msgid "Choose a DNSSEC and DANE mode."
msgstr "בחר מצב DNSSEC ו-DANE."

#: plugins/mqtt/src/dns_security_group.vala:64
msgid "Enable TLS before enabling DNSSEC and DANE for this broker."
msgstr "הפעל את TLS לפני הפעלת DNSSEC ו-DANE עבור ברוקר זה."

#: plugins/mqtt/src/dns_security_group.vala:68
msgid "Enter an HTTPS resolver URL without credentials or a fragment."
msgstr "יש להזין כתובת HTTPS של פותר DNS, ללא פרטי גישה או סיומת fragment."

#: plugins/mqtt/src/dns_security_group.vala:79
msgid ""
"Connection stopped by the selected security policy. Check the broker, DNS "
"resolver and TLS settings, then save and apply to retry."
msgstr ""
"החיבור הופסק על ידי מדיניות האבטחה שנבחרה. בדוק את הגדרות הברוקר, פותר ה-DNS"
" ו-TLS, ולאחר מכן שמור והחל כדי לנסות שוב."

#: plugins/mqtt/src/dns_security_group.vala:84
msgid "Connected without TLS."
msgstr "מחובר ללא TLS."

#: plugins/mqtt/src/dns_security_group.vala:85
msgid "Connected with ordinary TLS; DANE is not active."
msgstr "מחובר עם TLS רגיל; DANE אינו פעיל."

#: plugins/mqtt/src/dns_security_group.vala:86
msgid "No active verified connection."
msgstr "אין חיבור מאומת פעיל."

