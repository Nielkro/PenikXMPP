msgstr "צומת (השאירו את ברירת המחדל עבור עדכונים אישיים)"

#: main/src/ui/feeds_dialog.vala:100
msgid "Advanced feed settings"
msgstr "הגדרות עדכון מתקדמות"

#: main/src/ui/feeds_dialog.vala:100
msgid "For personal feeds, keep the default node."
msgstr "עבור עדכונים אישיים, שמור על צומת ברירת המחדל."

#: main/src/ui/feeds_dialog.vala:104
msgid "Read XMPP feed"
msgstr "קרא ערוץ עדכונים ב-XMPP"

