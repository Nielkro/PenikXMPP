#~ "\n"
#~ "HA Discovery:\n"
#~ "  /mqtt discovery         — Show discovery status\n"
#~ "  /mqtt discovery on      — Enable & publish\n"
#~ "  /mqtt discovery off     — Disable & remove"
#~ msgstr ""
#~ "MQTT Bot-Befehle\n"
#~ "─────────────────\n"
#~ "/mqtt status              — Verbindungsstatus\n"
#~ "/mqtt subscribe <topic>   — Thema abonnieren\n"
#~ "/mqtt unsubscribe <topic> — Thema abbestellen\n"
#~ "/mqtt publish <t> <msg>   — An Thema veröffentlichen\n"
#~ "/mqtt topics              — Abonnements auflisten\n"
#~ "/mqtt alias <topic> <name>— Thema-Alias setzen\n"
#~ "/mqtt aliases             — Alle Aliase auflisten\n"
#~ "/mqtt rmalias <topic>     — Alias entfernen\n"
#~ "/mqtt qos <topic> <0|1|2> — QoS-Level für Thema setzen\n"
#~ "/mqtt chart <topic> [N]   — Sparkline-Diagramm\n"
#~ "/mqtt bridge <topic> <jid>— An XMPP-Kontakt weiterleiten\n"
#~ "/mqtt bridges             — Bridge-Regeln auflisten\n"
#~ "/mqtt rmbridge <number>   — Bridge-Regel entfernen\n"
