#~ "\n"
#~ "Preset example:\n"
#~ "  /mqtt preset add LichtAN home/light/set ON\n"
#~ "  /mqtt preset LichtAN\n"
#~ "\n"
#~ "QoS levels: 0 (fire&forget), 1 (ack), 2 (exactly once)\n"
#~ "Priority levels: silent, normal, alert, critical\n"
