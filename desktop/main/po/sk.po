msgstr "Pred zapnutím DNSSEC a DANE pre tohto brokera povoľte TLS."

#: plugins/mqtt/src/dns_security_group.vala:68
msgid "Enter an HTTPS resolver URL without credentials or a fragment."
msgstr ""
"Zadajte URL prekladača cez HTTPS bez prihlasovacích údajov a fragmentu."

#: plugins/mqtt/src/dns_security_group.vala:79
msgid ""
"Connection stopped by the selected security policy. Check the broker, DNS "
"resolver and TLS settings, then save and apply to retry."
msgstr ""
"Pripojenie zastavili vybrané bezpečnostné pravidlá. Skontrolujte brokera, "
"prekladač DNS a nastavenia TLS, potom ich uložte a použite na ďalší pokus."

