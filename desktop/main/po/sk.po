#: main/src/ui/conversation_content_view/message_diagnostics.vala:18
msgid "This OMEMO message could not be decrypted on this device."
msgstr "Túto správu OMEMO sa na tomto zariadení nepodarilo dešifrovať."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:25
msgid "Delivery failed. No reason was provided."
msgstr "Doručenie zlyhalo. Dôvod nebol uvedený."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:28
msgid ""
"Delivery failed. The recipient is using OMEMO. Switch this chat to OMEMO or "
"send unencrypted."
msgstr ""
"Doručenie zlyhalo. Príjemca používa OMEMO. Prepnite tento chat na OMEMO "
"alebo odošlite správu bez šifrovania."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:31
msgid ""
"Delivery failed. The recipient is using OpenPGP. Switch this chat to OpenPGP"
" or send unencrypted."
msgstr ""
"Doručenie zlyhalo. Príjemca používa OpenPGP. Prepnite tento chat na OpenPGP "
"alebo odošlite správu bez šifrovania."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:34
msgid ""
"Delivery failed. The recipient is using unencrypted messages. Switch this "
"chat to unencrypted."
msgstr ""
"Doručenie zlyhalo. Príjemca používa nešifrované správy. Prepnite tento chat "
"na nešifrovaný."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:37
msgid ""
"Delivery failed. OMEMO is selected, but this message was not encrypted with "
"OMEMO. Switch the chat encryption mode or send unencrypted."
msgstr ""
"Doručenie zlyhalo. Je vybrané OMEMO, ale táto správa nebola zašifrovaná "
"pomocou OMEMO. Zmeňte režim šifrovania chatu alebo odošlite správu bez "
"šifrovania."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:40
msgid ""
"Delivery failed. OpenPGP is selected, but this message was not encrypted "
"with OpenPGP. Switch the chat encryption mode or send unencrypted."
msgstr ""
"Doručenie zlyhalo. Je vybrané OpenPGP, ale táto správa nebola zašifrovaná "
"pomocou OpenPGP. Zmeňte režim šifrovania chatu alebo odošlite správu bez "
"šifrovania."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:43
msgid ""
"Delivery failed. Unencrypted messages are selected, but this message still "
"contains encrypted data. Switch the chat encryption mode before sending."
msgstr ""
"Doručenie zlyhalo. Sú vybrané nešifrované správy, ale táto správa stále "
"obsahuje šifrované údaje. Pred odoslaním zmeňte režim šifrovania chatu."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:47
msgid ""
"Delivery failed. The replied-to message is no longer available in this "
"conversation."
msgstr ""
"Doručenie zlyhalo. Správa, na ktorú odpovedáte, už nie je v tejto "
"konverzácii dostupná."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:50
msgid ""
"Delivery failed. The replied-to group message is not ready to be referenced "
"yet. Try again shortly."
msgstr ""
"Doručenie zlyhalo. Na skupinovú správu, na ktorú odpovedáte, zatiaľ nemožno "
"odkázať. Skúste to o chvíľu znova."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:53
msgid "Delivery failed. The replied-to message cannot be referenced safely."
msgstr ""
"Doručenie zlyhalo. Na správu, na ktorú odpovedáte, nemožno bezpečne odkázať."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:56
msgid ""
"OMEMO requires a members-only room that exposes participants' XMPP "
"addresses."
msgstr ""
"OMEMO vyžaduje miestnosť iba pre členov, ktorá sprístupňuje adresy XMPP "
"účastníkov."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:60
msgid "Cannot verify the room members. Check room permissions and try again."
msgstr ""
"Členov miestnosti nemožno overiť. Skontrolujte oprávnenia miestnosti a "
"skúste to znova."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:63
msgid "Invite another member before sending an OMEMO message."
msgstr "Pred odoslaním správy OMEMO pozvite ďalšieho člena."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:66
msgid ""
"No trusted device of another room member is available. Review the room "
"members' OMEMO keys."
