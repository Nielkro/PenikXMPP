#: main/src/ui/conversation_content_view/message_diagnostics.vala:16
msgid "This OMEMO message could not be decrypted on this device."
msgstr "Tämän OMEMO-viestin salausta ei voitu purkaa tällä laitteella."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:23
msgid "Delivery failed. No reason was provided."
msgstr "Toimitus epäonnistui. Syytä ei ilmoitettu."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:26
msgid ""
"Delivery failed. The recipient is using OMEMO. Switch this chat to OMEMO or "
"send unencrypted."
msgstr ""
"Toimitus epäonnistui. Vastaanottaja käyttää OMEMO-salausta. Vaihda tämän "
"keskustelun salaukseksi OMEMO tai lähetä salaamatta."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:29
msgid ""
"Delivery failed. The recipient is using OpenPGP. Switch this chat to OpenPGP"
" or send unencrypted."
msgstr ""
"Toimitus epäonnistui. Vastaanottaja käyttää OpenPGP-salausta. Vaihda tämän "
"keskustelun salaukseksi OpenPGP tai lähetä salaamatta."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:32
msgid ""
"Delivery failed. The recipient is using unencrypted messages. Switch this "
"chat to unencrypted."
msgstr ""
"Toimitus epäonnistui. Vastaanottaja käyttää salaamattomia viestejä. Vaihda "
"tämä keskustelu salaamattomaksi."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:35
msgid ""
"Delivery failed. OMEMO is selected, but this message was not encrypted with "
"OMEMO. Switch the chat encryption mode or send unencrypted."
msgstr ""
"Toimitus epäonnistui. OMEMO on valittu, mutta tätä viestiä ei salattu "
"OMEMOlla. Vaihda keskustelun salaustapaa tai lähetä salaamatta."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:38
msgid ""
"Delivery failed. OpenPGP is selected, but this message was not encrypted "
"with OpenPGP. Switch the chat encryption mode or send unencrypted."
msgstr ""
"Toimitus epäonnistui. OpenPGP on valittu, mutta tätä viestiä ei salattu "
"OpenPGP:llä. Vaihda keskustelun salaustapaa tai lähetä salaamatta."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:41
msgid ""
"Delivery failed. Unencrypted messages are selected, but this message still "
"contains encrypted data. Switch the chat encryption mode before sending."
msgstr ""
"Toimitus epäonnistui. Salaamattomat viestit on valittu, mutta tämä viesti "
"sisältää yhä salattuja tietoja. Vaihda keskustelun salaustapaa ennen "
"lähettämistä."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:45
msgid ""
"Delivery failed. The replied-to message is no longer available in this "
"conversation."
msgstr ""
"Toimitus epäonnistui. Viesti, johon vastataan, ei ole enää saatavilla tässä "
"keskustelussa."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:48
msgid ""
"Delivery failed. The replied-to group message is not ready to be referenced "
"yet. Try again shortly."
msgstr ""
"Toimitus epäonnistui. Ryhmäviestiin, johon vastataan, ei voi vielä viitata. "
"Yritä hetken kuluttua uudelleen."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:51
msgid "Delivery failed. The replied-to message cannot be referenced safely."
msgstr ""
"Toimitus epäonnistui. Viestiin, johon vastataan, ei voida viitata "
"turvallisesti."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:54
msgid ""
"OMEMO requires a members-only room that exposes participants' XMPP "
"addresses."
msgstr ""
"OMEMO edellyttää vain jäsenille tarkoitettua ryhmää, jossa osallistujien "
"XMPP-osoitteet näkyvät."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:58
msgid "Cannot verify the room members. Check room permissions and try again."
msgstr ""
"Ryhmän jäseniä ei voida vahvistaa. Tarkista ryhmän oikeudet ja yritä "
"uudelleen."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:61
msgid "Invite another member before sending an OMEMO message."
msgstr "Kutsu toinen jäsen ennen OMEMO-viestin lähettämistä."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:64
msgid ""
"No trusted device of another room member is available. Review the room "
"members' OMEMO keys."
msgstr ""
"Muiden ryhmän jäsenten luotettuja laitteita ei ole käytettävissä. Tarkista "
"ryhmän jäsenten OMEMO-avaimet."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:66
#, c-format
msgid "Delivery failed. Reason: %s"
msgstr "Toimitus epäonnistui. Syy: %s"

