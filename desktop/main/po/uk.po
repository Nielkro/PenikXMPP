msgstr "Читайте стрічки RSS чи Atom і діліться окремими статтями в чаті."

#: main/src/ui/feeds_dialog.vala:76
msgid "Feed URL"
msgstr "Адреса стрічки"

#: main/src/ui/feeds_dialog.vala:80
msgid "Load articles"
msgstr "Завантажити статті"

#: main/src/ui/feeds_dialog.vala:83
