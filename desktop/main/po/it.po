msgstr "Consegna non riuscita. Non è stato fornito un motivo."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:26
msgid ""
"Delivery failed. The recipient is using OMEMO. Switch this chat to OMEMO or "
"send unencrypted."
msgstr ""
"Consegna non riuscita. Il destinatario usa OMEMO. Imposta OMEMO per questa "
"chat oppure invia senza cifratura."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:29
msgid ""
"Delivery failed. The recipient is using OpenPGP. Switch this chat to OpenPGP"
" or send unencrypted."
msgstr ""
"Consegna non riuscita. Il destinatario usa OpenPGP. Imposta OpenPGP per "
"questa chat oppure invia senza cifratura."

