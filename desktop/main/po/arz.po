#: plugins/mqtt/src/command_handler.vala:746
msgid ""
"Usage: /mqtt alert <topic> <op> <value>\n"
"\n"
"Operators: > < >= <= == != contains\n"
"\n"
"Examples:\n"
"  /mqtt alert home/temp > 30\n"
"  /mqtt alert home/sensors/# contains error\n"
"  /mqtt alert home/data.temperature > 25\n"
"    (checks JSON field 'temperature')"
msgstr ""
"الاستخدام: /mqtt alert <topic> <op> <value>\n"
"\n"
"المعاملات: > < >= <= == != contains\n"
"\n"
"أمثلة:\n"
"  /mqtt alert home/temp > 30\n"
"  /mqtt alert home/sensors/# contains error\n"
"  /mqtt alert home/data.temperature > 25\n"
"    (بيفحص خانة JSON اللي اسمها 'temperature')"

