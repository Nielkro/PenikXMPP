msgstr "Ha fallat el lliurament. No se n'ha indicat el motiu."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:26
msgid ""
"Delivery failed. The recipient is using OMEMO. Switch this chat to OMEMO or "
"send unencrypted."
msgstr ""
"Ha fallat el lliurament. El destinatari utilitza OMEMO. Canvieu aquest xat a"
" OMEMO o envieu sense xifrar."

#: main/src/ui/conversation_content_view/message_diagnostics.vala:29
msgid ""
"Delivery failed. The recipient is using OpenPGP. Switch this chat to OpenPGP"
" or send unencrypted."
msgstr ""
"Ha fallat el lliurament. El destinatari utilitza OpenPGP. Canvieu aquest xat"
" a OpenPGP o envieu sense xifrar."

