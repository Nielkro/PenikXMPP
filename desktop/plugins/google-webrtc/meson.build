engine_sources = files(
    'src/audio_message_recorder_v2.vala',
    'src/audio_message_writer.vala',
    'src/engine_media_device.vala',
    'src/engine_jmi_iq_interceptor.vala',
    'src/engine_jmi_session_router.vala',
    'src/engine_jmi_session.vala',
    'src/engine_jingle_session.vala',
    'src/engine_jingle_wire_session.vala',
    'src/engine_muji_codec_probe.vala',
    'src/engine_muji_group_session.vala',
    'src/ice_servers.vala',
    'src/media_foundation_writer.vapi',
    'src/media_message_playback_provider.vala',
    'src/media_message_recorder_provider.vala',
    'src/media_message_recorder_native.vala',
    'src/media_policy.vala',
    'src/native_handles.vapi',
    'src/native.vala',
    'src/native_video_effects.vala',
    'src/signaling_session.vala',
    'src/session_owner.vala',
    'src/video_effect_config.vala',
    'src/video_effect_pipeline.vala',
    'src/video_message_recorder_v2.vala',
    'src/video_message_writer.vala',
)

plugin_sources = engine_sources + files(
    'src/plugin.vala',
    'src/register_plugin.vala',
)

engine_dependencies = [
    dep_dinox_google_webrtc,
    dep_dino,
    dep_gee,
    dep_gio,
    dep_glib,
    dep_qlite,
    dep_xmpp_vala,
]

plugin_dependencies = engine_dependencies + [
    dep_gmodule,
]

google_webrtc_platform_sources = []
if host_machine.system() == 'windows'
    google_webrtc_platform_sources += files('src/media_foundation_writer.cpp')
    google_webrtc_platform_dependencies = [
        meson.get_compiler('cpp').find_library('mfplat', required: true),
        meson.get_compiler('cpp').find_library('mfreadwrite', required: true),
        meson.get_compiler('cpp').find_library('mfuuid', required: true),
        meson.get_compiler('cpp').find_library('ole32', required: true),
    ]
    engine_dependencies += google_webrtc_platform_dependencies
    plugin_dependencies += google_webrtc_platform_dependencies

    if get_option('google-libwebrtc-tests')
        google_webrtc_media_foundation_smoke = executable(
            'google-webrtc-media-foundation-writer-smoke',
            google_webrtc_platform_sources + files('tests/media_foundation_writer_smoke.cpp'),
            include_directories: include_directories('src'),
            dependencies: google_webrtc_platform_dependencies,
            install: false,
        )
        test(
            'google-webrtc-media-foundation-writer-smoke',
            google_webrtc_media_foundation_smoke,
            timeout: 30,
        )
    endif
endif

engine_c_args = [
    '-DG_LOG_DOMAIN="google-webrtc"',
    '-DGETTEXT_PACKAGE="dino"',
]
if host_machine.system() == 'windows'
    # GCC 16 warns about unused helpers and cleanup labels generated by valac.
    # Keep the strict Vala warning gate while ignoring only that generated C noise.
    engine_c_args += [
        '-Wno-unused-function',
        '-Wno-unused-label',
    ]
endif
google_webrtc_native_include_directories = include_directories('src')

google_webrtc_test_env = environment()
google_webrtc_test_env.set('DINOX_GOOGLE_WEBRTC_AUDIO_DEVICE', 'synthetic')
if host_machine.system() == 'windows' and google_libwebrtc_prebuilt_runtime
    google_webrtc_windows_runtime_bin = google_libwebrtc_runtime_root != '' \
        ? google_libwebrtc_runtime_root / 'bin' \
        : google_libwebrtc_artifact_root / 'bin'
    google_webrtc_test_env.prepend('PATH', google_webrtc_windows_runtime_bin)
endif
if get_option('google-libwebrtc-test-oracle')
    google_webrtc_test_env.set('DINOX_WEBRTC_IN_PROCESS_TEST_ORACLE', '1')
endif

google_webrtc_native_build_rpath = '$ORIGIN:$ORIGIN/../../google-webrtc:$ORIGIN/../../libdino:$ORIGIN/../../xmpp-vala'
if google_libwebrtc_prebuilt_runtime
    if host_machine.system() == 'windows'
        google_webrtc_native_build_rpath += ';' + google_webrtc_windows_runtime_bin
    else
        google_webrtc_native_build_rpath += ':' + google_libwebrtc_runtime_root / 'lib'
    endif
endif

google_webrtc_install_rpath = default_install_rpath
if host_machine.system() != 'windows'
    fs = import('fs')
    google_webrtc_plugin_install_dir = get_option('prefix') / get_option('libdir') / get_option('plugindir')
    google_webrtc_library_install_dir = get_option('prefix') / get_option('libdir')
    google_webrtc_private_install_dir = get_option('prefix') / 'lib/dinox'
    google_webrtc_library_relative_dir = fs.relative_to(
        google_webrtc_library_install_dir,
        google_webrtc_plugin_install_dir,
    )
    google_webrtc_private_relative_dir = fs.relative_to(
        google_webrtc_private_install_dir,
        google_webrtc_plugin_install_dir,
    )
    google_webrtc_install_rpath = \
        '$ORIGIN/' + google_webrtc_library_relative_dir + \
        ':$ORIGIN/' + google_webrtc_private_relative_dir
endif

lib_google_webrtc_engine = shared_library(
    'google-webrtc',
    plugin_sources + google_webrtc_platform_sources,
    name_prefix: '',
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: plugin_dependencies,
    install: true,
    install_dir: get_option('libdir') / get_option('plugindir'),
    install_rpath: google_webrtc_install_rpath,
    build_rpath: google_webrtc_native_build_rpath,
)

if get_option('google-libwebrtc-tests')
google_webrtc_smoke_sources = engine_sources + google_webrtc_platform_sources + files(
    'tests/compiler_warning_anchor.vala',
)
google_webrtc_plugin_smoke_sources = plugin_sources + google_webrtc_platform_sources + files(
    'tests/compiler_warning_anchor.vala',
)
google_webrtc_smoke_vala_args = ['--define=GOOGLE_WEBRTC_EFFECT_TEST']

google_webrtc_engine_smoke = executable(
    'google-webrtc-engine-smoke',
    google_webrtc_smoke_sources + files('tests/engine_smoke.vala', 'tests/media_message_provider_devices.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-engine-smoke', google_webrtc_engine_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_signaling_smoke = executable(
    'google-webrtc-signaling-smoke',
    google_webrtc_smoke_sources + files('tests/signaling_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-signaling-smoke', google_webrtc_signaling_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_jingle_engine_smoke = executable(
    'google-webrtc-jingle-engine-smoke',
    google_webrtc_smoke_sources + files('tests/jingle_engine_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-jingle-engine-smoke', google_webrtc_jingle_engine_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_jingle_wire_smoke = executable(
    'google-webrtc-jingle-wire-smoke',
    google_webrtc_smoke_sources + files('tests/jingle_wire_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-jingle-wire-smoke', google_webrtc_jingle_wire_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_jmi_wire_smoke = executable(
    'google-webrtc-jmi-wire-smoke',
    google_webrtc_smoke_sources + files('tests/jmi_wire_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-jmi-wire-smoke', google_webrtc_jmi_wire_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_plugin_capability_smoke = executable(
    'google-webrtc-plugin-capability-smoke',
    google_webrtc_plugin_smoke_sources + files('tests/plugin_capability_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: plugin_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-plugin-capability-smoke', google_webrtc_plugin_capability_smoke,
    env: google_webrtc_test_env, timeout: 20)

google_webrtc_audio_only_smoke = executable(
    'google-webrtc-audio-only-smoke',
    google_webrtc_smoke_sources + files('tests/audio_only_smoke.vala'),
    vala_args: google_webrtc_smoke_vala_args,
    c_args: engine_c_args,
    include_directories: google_webrtc_native_include_directories,
    dependencies: engine_dependencies,
    install: false,
    build_rpath: google_webrtc_native_build_rpath,
)

test('google-webrtc-audio-only-smoke', google_webrtc_audio_only_smoke,
    env: google_webrtc_test_env, timeout: 20)

if host_machine.system() != 'windows'
    google_webrtc_process_test_env = environment()
    google_webrtc_process_test_env.set('DINOX_GOOGLE_WEBRTC_AUDIO_DEVICE', 'synthetic')
    google_webrtc_process_test_depends = []
    if google_libwebrtc_prebuilt_runtime
        google_webrtc_process_test_env.set(
            'DINOX_WEBRTC_WORKER_PATH',
            google_libwebrtc_runtime_root / 'lib/dinox-webrtc-worker')
        google_webrtc_process_test_env.prepend(
            'LD_LIBRARY_PATH', google_libwebrtc_runtime_root / 'lib')
    else
        google_webrtc_process_test_env.set(
            'DINOX_WEBRTC_WORKER_PATH',
            dinox_google_webrtc_worker.full_path())
        google_webrtc_process_test_depends = [dinox_google_webrtc_worker]
    endif

    test('google-webrtc-process-audio-only-smoke', google_webrtc_audio_only_smoke,
        env: google_webrtc_process_test_env,
        depends: google_webrtc_process_test_depends,
        is_parallel: false,
        timeout: 20)
    test('google-webrtc-process-jmi-wire-smoke', google_webrtc_jmi_wire_smoke,
        env: google_webrtc_process_test_env,
        depends: google_webrtc_process_test_depends,
        is_parallel: false,
        timeout: 30)
    test('google-webrtc-process-plugin-capability-smoke',
        google_webrtc_plugin_capability_smoke,
        env: google_webrtc_process_test_env,
        depends: google_webrtc_process_test_depends,
        is_parallel: false,
        timeout: 30)
endif
endif

summary('Google/libwebrtc call engine (google-webrtc)', true, bool_yn: true, section: 'Plugins')
summary('Google/libwebrtc smoke tests', get_option('google-libwebrtc-tests'), bool_yn: true, section: 'Google/libwebrtc')
