msgstr "Tidak ada kunci kirim OpenPGP yang aktif untuk akun ini."

#: plugins/openpgp/src/key_management_dialog.vala:199
#, c-format
msgid "Keys and server backups for %s"
msgstr "Kunci dan cadangan server untuk %s"

#: plugins/openpgp/src/key_management_dialog.vala:223
msgid ""
"Import a private key for this account or a public key from a contact. "
"Importing does not activate a key."
msgstr ""
"Impor kunci pribadi untuk akun ini atau kunci publik dari kontak. Mengimpor "
"tidak mengaktifkan kunci."

