"Remove locally without revocation; active XMPP publication is removed first"
msgstr ""
"Fjern lokalt uten tilbakekalling; aktiv XMPP-publisering fjernes først"

#: plugins/openpgp/src/key_management_dialog.vala:895
msgid "Revoked"
msgstr "Tilbakekalt"

