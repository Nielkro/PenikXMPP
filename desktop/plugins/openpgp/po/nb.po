msgstr "Eksporter hemmelig nøkkel (sikkerhetskopi)"

#: plugins/openpgp/src/key_management_dialog.vala:840
msgid "Required for restoring your key"
msgstr "Påkrevd for å gjenopprette nøkkelen"

#: plugins/openpgp/src/key_management_dialog.vala:849
msgid "Revoke Key"
msgstr "Tilbakekall nøkkel"

#: plugins/openpgp/src/key_management_dialog.vala:850
