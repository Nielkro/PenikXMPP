#: plugins/openpgp/src/contact_details_provider.vala:163
msgid "OpenPGP Legacy (XEP-0027/keyserver)"
msgstr "Eldre OpenPGP (XEP-0027/nøkkelserver)"

#: plugins/openpgp/src/contact_details_provider.vala:176
msgid "Search keyserver"
msgstr "Søk på nøkkelserver"

#: plugins/openpgp/src/contact_details_provider.vala:184
msgid "OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/contact_details_provider.vala:196
msgid "Copy XMPP-published OpenPGP fingerprint"
msgstr "Kopier fingeravtrykket til OpenPGP-nøkkelen publisert via XMPP"

#: plugins/openpgp/src/contact_details_provider.vala:205
msgid "Mark XMPP-published key as verified"
msgstr "Merk XMPP-publisert nøkkel som verifisert"

#: plugins/openpgp/src/contact_details_provider.vala:211
msgid "Reset XMPP-published key verification"
msgstr "Tilbakestill verifisering av XMPP-publisert nøkkel"

#: plugins/openpgp/src/contact_details_provider.vala:226
msgid "Refresh XMPP-published key"
msgstr "Oppdater XMPP-publisert nøkkel"

#: plugins/openpgp/src/contact_details_provider.vala:337
msgid "Checking XMPP-published OpenPGP key..."
msgstr "Kontrollerer OpenPGP-nøkkel publisert via XMPP..."

#: plugins/openpgp/src/contact_details_provider.vala:350
msgid "Checking the XMPP-published OpenPGP key timed out."
msgstr "Kontrollen av OpenPGP-nøkkelen publisert via XMPP fikk tidsavbrudd."

#: plugins/openpgp/src/contact_details_provider.vala:389
msgid "Checking keyring..."
msgstr "Kontrollerer nøkkelring..."

#: plugins/openpgp/src/contact_details_provider.vala:427
msgid "Invalid for legacy XEP-0027/keyserver: key has no email user ID."
msgstr ""
"Ugyldig for eldre XEP-0027/nøkkelserver: Nøkkelen har ingen bruker-ID med "
"e-postadresse."

#: plugins/openpgp/src/contact_details_provider.vala:428
msgid "Invalid for OpenPGP for XMPP: key has no matching xmpp: user ID."
msgstr ""
"Ugyldig for OpenPGP for XMPP: Nøkkelen har ingen samsvarende xmpp:-bruker-"
"ID."

#: plugins/openpgp/src/contact_details_provider.vala:439
msgid "Key not in keyring"
msgstr "Nøkkelen finnes ikke i nøkkelringen"

#: plugins/openpgp/src/contact_details_provider.vala:446
msgid ""
"Active: legacy XEP-0027/keyserver key is currently usable for this contact."
msgstr ""
"Aktiv: Den eldre XEP-0027-/nøkkelservernøkkelen kan brukes for denne "
"kontakten nå."

#: plugins/openpgp/src/contact_details_provider.vala:449
msgid ""
"Stored: legacy XEP-0027/keyserver key is known, but is not currently active "
"for this contact."
msgstr ""
"Lagret: Den eldre XEP-0027-/nøkkelservernøkkelen er kjent, men er ikke aktiv"
" for denne kontakten nå."

#: plugins/openpgp/src/contact_details_provider.vala:451
msgid "Inactive: no legacy XEP-0027/keyserver key is stored."
msgstr "Inaktiv: Ingen eldre XEP-0027-/nøkkelservernøkkel er lagret."

#: plugins/openpgp/src/contact_details_provider.vala:457
msgid "Verified: XMPP-published OpenPGP key is stored and manually verified."
msgstr ""
"Verifisert: OpenPGP-nøkkelen publisert via XMPP er lagret og manuelt "
"verifisert."

#: plugins/openpgp/src/contact_details_provider.vala:460
msgid ""
"Changed: XMPP-published OpenPGP key differs from the previously verified "
"key. Verify the fingerprint before trusting this identity."
msgstr ""
"Endret: OpenPGP-nøkkelen publisert via XMPP er forskjellig fra den tidligere"
" verifiserte nøkkelen. Verifiser fingeravtrykket før du stoler på denne "
"identiteten."

#: plugins/openpgp/src/contact_details_provider.vala:462
msgid ""
"Unverified: XMPP-published OpenPGP key is stored. Compare the fingerprint "
"before trusting this identity."
msgstr ""
"Ikke verifisert: OpenPGP-nøkkelen publisert via XMPP er lagret. Sammenlign "
"fingeravtrykket før du stoler på denne identiteten."

#: plugins/openpgp/src/contact_details_provider.vala:465
msgid ""
"Supported: contact advertises OpenPGP for XMPP, but no retrievable XMPP-"
"published key is stored."
msgstr ""
"Støttet: Kontakten annonserer OpenPGP for XMPP, men ingen hentbar XMPP-"
"publisert nøkkel er lagret."

#: plugins/openpgp/src/contact_details_provider.vala:467
msgid "Inactive: no OpenPGP-for-XMPP support or XMPP-published key is known."
msgstr ""
"Inaktiv: Ingen støtte for OpenPGP for XMPP eller XMPP-publisert nøkkel er "
"kjent."

#: plugins/openpgp/src/contact_details_provider.vala:497
msgid "Fingerprint copied"
msgstr "Fingeravtrykk kopiert"

#: plugins/openpgp/src/contact_details_provider.vala:520
msgid "Verifying OpenPGP-for-XMPP key..."
msgstr "Verifiserer OpenPGP-for-XMPP-nøkkel..."

#: plugins/openpgp/src/contact_details_provider.vala:554
msgid ""
"Cannot verify: key is not in the keyring or has no matching xmpp: user ID."
msgstr ""
"Kan ikke verifisere: Nøkkelen finnes ikke i nøkkelringen eller har ingen "
"samsvarende xmpp:-bruker-ID."

#: plugins/openpgp/src/contact_details_provider.vala:611
msgid "Searching keyserver with fingerprint: "
msgstr "Søker på nøkkelserver med fingeravtrykk: "

#: plugins/openpgp/src/contact_details_provider.vala:626
msgid ""
"Key not found or has no verified email on keyserver.\n"
"Ask the contact to verify their email on keys.openpgp.org\n"
"or send you their public key file directly."
msgstr ""
"Nøkkelen ble ikke funnet eller har ingen verifisert e-postadresse på nøkkelserveren.\n"
"Be kontakten verifisere e-postadressen på keys.openpgp.org\n"
"eller sende filen med den offentlige nøkkelen direkte til deg."

#: plugins/openpgp/src/contact_details_provider.vala:628
msgid "Failed: "
msgstr "Mislyktes: "

#: plugins/openpgp/src/contact_details_provider.vala:636
msgid "Searching keyserver with JID..."
msgstr "Søker på nøkkelserver med JID..."

#: plugins/openpgp/src/contact_details_provider.vala:657
msgid "Not found with JID. Enter email address:"
msgstr "Ikke funnet med JID. Skriv inn e-postadresse:"

#: plugins/openpgp/src/contact_details_provider.vala:668
msgid "Enter Email Address"
msgstr "Skriv inn e-postadresse"

#: plugins/openpgp/src/contact_details_provider.vala:669
msgid ""
"The key was not found using the JID.\n"
"\n"
"Enter the email address that is in the contact's OpenPGP key:"
msgstr ""
"Nøkkelen ble ikke funnet med JID-en.\n"
"\n"
"Skriv inn e-postadressen som finnes i kontaktens OpenPGP-nøkkel:"

#: plugins/openpgp/src/contact_details_provider.vala:671
#: plugins/openpgp/src/key_management_dialog.vala:1045
#: plugins/openpgp/src/key_management_dialog.vala:1486
#: plugins/openpgp/src/key_management_dialog.vala:1654
#: plugins/openpgp/src/key_management_dialog.vala:1694
#: plugins/openpgp/src/key_management_dialog.vala:1789
#: plugins/openpgp/src/key_management_dialog.vala:1924
#: plugins/openpgp/src/key_management_dialog.vala:2108
#: plugins/openpgp/src/key_management_dialog.vala:2270
#: plugins/openpgp/src/key_management_dialog.vala:2866
#: plugins/openpgp/src/key_management_dialog.vala:3211
#: plugins/openpgp/src/key_management_dialog.vala:3213
#: plugins/openpgp/src/plugin.vala:453
msgid "Cancel"
msgstr "Avbryt"

#: plugins/openpgp/src/contact_details_provider.vala:672
msgid "Search"
msgstr "Søk"

#: plugins/openpgp/src/contact_details_provider.vala:709
msgid "Searching keyserver for: "
msgstr "Søker på nøkkelserver etter: "

#: plugins/openpgp/src/contact_details_provider.vala:719
msgid "Not found: "
msgstr "Ikke funnet: "

#: plugins/openpgp/src/encryption_list_entry.vala:66
msgid "No conversation selected."
msgstr "Ingen samtale valgt."

#: plugins/openpgp/src/encryption_list_entry.vala:75
msgid ""
"You didn't configure OpenPGP for this account. You can do that in the "
"Accounts Dialog."
msgstr ""
"Du har ikke konfigurert OpenPGP for denne kontoen. Det kan du gjøre i "
"kontodialogen."

#: plugins/openpgp/src/encryption_list_entry.vala:113
#: plugins/openpgp/src/encryption_list_entry.vala:240
msgid "OpenPGP manager not available."
msgstr "OpenPGP-administrasjon er ikke tilgjengelig."

#: plugins/openpgp/src/encryption_list_entry.vala:121
msgid "OpenPGP-for-XMPP key manager not available."
msgstr "Nøkkeladministrasjon for OpenPGP for XMPP er ikke tilgjengelig."

#: plugins/openpgp/src/encryption_list_entry.vala:129
msgid "Checking OpenPGP key via PubSub..."
msgstr "Kontrollerer OpenPGP-nøkkel via PubSub..."

#: plugins/openpgp/src/encryption_list_entry.vala:138
msgid ""
"Checking the OpenPGP-for-XMPP key via PubSub timed out. Try again, or switch"
" to legacy XEP-0027 if the contact has a keyserver key."
msgstr ""
"Kontrollen av OpenPGP-for-XMPP-nøkkelen via PubSub fikk tidsavbrudd. Prøv "
"igjen, eller bytt til eldre XEP-0027 hvis kontakten har en nøkkel på en "
"nøkkelserver."

#: plugins/openpgp/src/encryption_list_entry.vala:150
msgid ""
"This contact's OpenPGP-for-XMPP key has not been refreshed yet. Try again "
"after the contact republishes it, or use the refresh button in contact "
"details."
msgstr ""
"Denne kontaktens OpenPGP-for-XMPP-nøkkel er ikke oppdatert ennå. Prøv igjen "
"etter at kontakten har publisert den på nytt, eller bruk oppdateringsknappen"
" i kontaktdetaljene."

#: plugins/openpgp/src/encryption_list_entry.vala:159
#: plugins/openpgp/src/encryption_list_entry.vala:215
msgid ""
"This contact has no legacy OpenPGP/XEP-0027 key. Switch your OpenPGP key "
"usage to DinoX / OpenPGP for XMPP."
msgstr ""
"Denne kontakten har ingen eldre OpenPGP-/XEP-0027-nøkkel. Bytt OpenPGP-"
"nøkkelbruken til DinoX / OpenPGP for XMPP."

#: plugins/openpgp/src/encryption_list_entry.vala:161
#: plugins/openpgp/src/encryption_list_entry.vala:211
msgid ""
"This contact has no OpenPGP-for-XMPP key. Switch to a legacy XEP-0027 key or"
" ask the contact to publish an OpenPGP-for-XMPP key."
msgstr ""
"Denne kontakten har ingen OpenPGP-for-XMPP-nøkkel. Bytt til en eldre "
"XEP-0027-nøkkel eller be kontakten publisere en OpenPGP-for-XMPP-nøkkel."

#: plugins/openpgp/src/encryption_list_entry.vala:171
#: plugins/openpgp/src/manager.vala:1119
msgid ""
"This contact's OpenPGP-for-XMPP key changed. Verify the fingerprint in "
"contact details before sending."
msgstr ""
"Denne kontaktens OpenPGP-for-XMPP-nøkkel er endret. Verifiser "
"fingeravtrykket i kontaktdetaljene før du sender."

#: plugins/openpgp/src/encryption_list_entry.vala:172
#: plugins/openpgp/src/manager.vala:1120
msgid ""
"This contact's OpenPGP-for-XMPP key is not verified. Verify the fingerprint "
"in contact details before sending."
msgstr ""
"Denne kontaktens OpenPGP-for-XMPP-nøkkel er ikke verifisert. Verifiser "
"fingeravtrykket i kontaktdetaljene før du sender."

#: plugins/openpgp/src/encryption_list_entry.vala:180
#: plugins/openpgp/src/encryption_list_entry.vala:219
#: plugins/openpgp/src/manager.vala:429
msgid ""
"This contact has a stored legacy OpenPGP/XEP-0027 key, but it is not "
"currently active."
msgstr ""
"Denne kontakten har en lagret eldre OpenPGP-/XEP-0027-nøkkel, men den er "
"ikke aktiv nå."

#: plugins/openpgp/src/encryption_list_entry.vala:200
msgid "This contact's OpenPGP key is not in your keyring."
msgstr "Denne kontaktens OpenPGP-nøkkel finnes ikke i nøkkelringen din."

#: plugins/openpgp/src/encryption_list_entry.vala:229
msgid "Legacy OpenPGP (XEP-0027/keyserver) is active for outgoing messages."
msgstr ""
"Eldre OpenPGP (XEP-0027/nøkkelserver) er aktiv for utgående meldinger."

#: plugins/openpgp/src/encryption_list_entry.vala:231
msgid "OpenPGP for XMPP (XEP-0373/0374) is active for outgoing messages."
msgstr "OpenPGP for XMPP (XEP-0373/0374) er aktiv for utgående meldinger."

#: plugins/openpgp/src/encryption_list_entry.vala:249
#, c-format
msgid "A member's OpenPGP key is not configured: %s"
msgstr "Et medlems OpenPGP-nøkkel er ikke konfigurert: %s"

#: plugins/openpgp/src/encryption_list_entry.vala:285
#, c-format
msgid "A member's OpenPGP key is not in your keyring: %s"
msgstr "Et medlems OpenPGP-nøkkel finnes ikke i nøkkelringen din: %s"

#: plugins/openpgp/src/encryption_preferences_entry.vala:51
msgid "Loading keys..."
msgstr "Laster nøkler..."

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
#: plugins/openpgp/src/encryption_preferences_entry.vala:127
#: plugins/openpgp/src/encryption_preferences_entry.vala:157
msgid "Outgoing OpenPGP messages"
msgstr "Utgående OpenPGP-meldinger"

#: plugins/openpgp/src/encryption_preferences_entry.vala:121
msgid "Error in GnuPG"
msgstr "Feil i GnuPG"

#: plugins/openpgp/src/encryption_preferences_entry.vala:127
msgid "No keys available. Generate or import one!"
msgstr "Ingen nøkler tilgjengelige. Opprett eller importer en!"

#: plugins/openpgp/src/encryption_preferences_entry.vala:159
msgid ""
"DinoX currently sends OpenPGP as legacy XEP-0027 using keyserver/contact "
"keys."
msgstr ""
"DinoX sender for øyeblikket OpenPGP som eldre XEP-0027 med "
"nøkkelserver-/kontaktnøkler."

#: plugins/openpgp/src/encryption_preferences_entry.vala:162
msgid "DinoX currently sends OpenPGP for XMPP using XEP-0373/0374."
msgstr "DinoX sender for øyeblikket OpenPGP for XMPP med XEP-0373/0374."

#: plugins/openpgp/src/encryption_preferences_entry.vala:165
msgid "No OpenPGP send key is active for this account."
msgstr "Ingen OpenPGP-sendenøkkel er aktiv for denne kontoen."

#: plugins/openpgp/src/encryption_preferences_entry.vala:229
msgid "Manage Keys"
msgstr "Administrer nøkler"

#: plugins/openpgp/src/encryption_preferences_entry.vala:230
msgid "Generate, import, export, or delete keys"
msgstr "Opprett, importer, eksporter eller slett nøkler"

#: plugins/openpgp/src/key_management_dialog.vala:171
msgid "OpenPGP Key Management"
msgstr "OpenPGP-nøkkeladministrasjon"

#: plugins/openpgp/src/key_management_dialog.vala:197
msgid "Actions"
msgstr "Handlinger"

#: plugins/openpgp/src/key_management_dialog.vala:199
#, c-format
msgid "Keys and server backups for %s"
msgstr "Nøkler og serversikkerhetskopier for %s"

#: plugins/openpgp/src/key_management_dialog.vala:204
msgid "Generate New Key"
msgstr "Opprett ny nøkkel"

#: plugins/openpgp/src/key_management_dialog.vala:205
msgid "Create a new OpenPGP key pair"
msgstr "Opprett et nytt OpenPGP-nøkkelpar"

#: plugins/openpgp/src/key_management_dialog.vala:222
msgid "Import Key"
msgstr "Importer nøkkel"

#: plugins/openpgp/src/key_management_dialog.vala:223
msgid ""
"Import a private key for this account or a public key from a contact. "
"Importing does not activate a key."
msgstr ""
"Importer en privat nøkkel for denne kontoen eller en offentlig nøkkel fra en"
" kontakt. Import aktiverer ikke en nøkkel."

#: plugins/openpgp/src/key_management_dialog.vala:240
#: plugins/openpgp/src/key_management_dialog.vala:1655
msgid "Delete Server Backup"
msgstr "Slett serversikkerhetskopi"

#: plugins/openpgp/src/key_management_dialog.vala:241
msgid ""
"Remove this account's encrypted private-key backup. Local keys and public-"
"key publications are kept."
msgstr ""
"Fjern denne kontoens krypterte sikkerhetskopi av den private nøkkelen. "
"Lokale nøkler og publiserte offentlige nøkler beholdes."

#: plugins/openpgp/src/key_management_dialog.vala:247
msgid "Fetch Key from Server (Sync)"
msgstr "Hent nøkkel fra server (synkronisering)"

#: plugins/openpgp/src/key_management_dialog.vala:248
msgid "Import your secret key backup from your server"
msgstr "Importer sikkerhetskopien av den hemmelige nøkkelen fra serveren din"

#: plugins/openpgp/src/key_management_dialog.vala:290
msgid "Your Keys"
msgstr "Dine nøkler"

#: plugins/openpgp/src/key_management_dialog.vala:291
msgid "Private keys available for signing and decryption"
msgstr "Private nøkler tilgjengelig for signering og dekryptering"

#: plugins/openpgp/src/key_management_dialog.vala:386
#: plugins/openpgp/src/key_management_dialog.vala:400
#: plugins/openpgp/src/key_management_dialog.vala:456
msgid "GnuPG did not respond."
msgstr "GnuPG svarte ikke."

#: plugins/openpgp/src/key_management_dialog.vala:412
msgid "Server Backup Cleanup Pending"
msgstr "Opprydding av serversikkerhetskopi venter"

#: plugins/openpgp/src/key_management_dialog.vala:413
msgid ""
"The key was kept locally. DinoX will retry removing its matching backup when"
" this account reconnects. Then retry revoking the key."
msgstr ""
"Nøkkelen ble beholdt lokalt. DinoX prøver å fjerne den tilhørende "
"sikkerhetskopien igjen når denne kontoen kobler til på nytt. Prøv deretter å"
" tilbakekalle nøkkelen igjen."

#: plugins/openpgp/src/key_management_dialog.vala:455
msgid "Could not load OpenPGP keys"
msgstr "Kunne ikke laste OpenPGP-nøkler"

#: plugins/openpgp/src/key_management_dialog.vala:470
msgid "No private keys found"
msgstr "Ingen private nøkler funnet"

#: plugins/openpgp/src/key_management_dialog.vala:471
msgid "Generate or import a key to get started"
msgstr "Opprett eller importer en nøkkel for å komme i gang"

#: plugins/openpgp/src/key_management_dialog.vala:646
msgid "Published to keyserver"
msgstr "Publisert på nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:652
msgid "Active legacy and XMPP account key"
msgstr "Aktiv kontonøkkel for eldre modus og XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active legacy XEP-0027 account key"
msgstr "Aktiv kontonøkkel for eldre XEP-0027"

#: plugins/openpgp/src/key_management_dialog.vala:653
msgid "Active XMPP account key"
msgstr "Aktiv XMPP-kontonøkkel"

#: plugins/openpgp/src/key_management_dialog.vala:659
msgid "Fingerprint"
msgstr "Fingeravtrykk"

#: plugins/openpgp/src/key_management_dialog.vala:672
msgid "Remove Assignment to This Account"
msgstr "Fjern tilknytning til denne kontoen"

#: plugins/openpgp/src/key_management_dialog.vala:673
msgid ""
"Keep the key in DinoX's keyring and remove only its manual assignment to "
"this account."
msgstr ""
"Behold nøkkelen i DinoX-nøkkelringen og fjern bare den manuelle "
"tilknytningen til denne kontoen."

#: plugins/openpgp/src/key_management_dialog.vala:684
msgid "OpenPGP for XMPP (XEP-0373/0374)"
msgstr "OpenPGP for XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/key_management_dialog.vala:686
msgid ""
"Active for this account. DinoX publishes this key through XMPP for OpenPGP-"
"capable clients."
msgstr ""
"Aktiv for denne kontoen. DinoX publiserer denne nøkkelen gjennom XMPP for "
"klienter med OpenPGP-støtte."

#: plugins/openpgp/src/key_management_dialog.vala:688
msgid ""
"Stored for OpenPGP for XMPP, but not active while legacy XEP-0027/keyserver "
"mode is selected."
msgstr ""
"Lagret for OpenPGP for XMPP, men ikke aktiv mens eldre "
"XEP-0027-/nøkkelservermodus er valgt."

#: plugins/openpgp/src/key_management_dialog.vala:690
msgid ""
"Inactive. This key is currently selected for legacy XEP-0027/keyserver use."
msgstr ""
"Inaktiv. Denne nøkkelen er for øyeblikket valgt for eldre "
"XEP-0027-/nøkkelserverbruk."

#: plugins/openpgp/src/key_management_dialog.vala:692
msgid ""
"Not available for this account. OpenPGP for XMPP keys must contain an xmpp: "
"user ID for this XMPP address."
msgstr ""
"Ikke tilgjengelig for denne kontoen. OpenPGP-for-XMPP-nøkler må inneholde en"
" xmpp:-bruker-ID for denne XMPP-adressen."

#: plugins/openpgp/src/key_management_dialog.vala:694
msgid ""
"Not active for this account. Select it below to publish it through XMPP."
msgstr ""
"Ikke aktiv for denne kontoen. Velg den nedenfor for å publisere den gjennom "
"XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:702
msgid "Selected for OpenPGP for XMPP"
msgstr "Valgt for OpenPGP for XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:703
msgid "Use for OpenPGP for XMPP"
msgstr "Bruk for OpenPGP for XMPP"

#: plugins/openpgp/src/key_management_dialog.vala:705
msgid ""
"DinoX uses this key for XEP-0373/0374 messages and publishes it through "
"XMPP."
msgstr ""
"DinoX bruker denne nøkkelen til XEP-0373/0374-meldinger og publiserer den "
"gjennom XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:708
msgid ""
"Selects this key for XEP-0373/0374 messages and publishes it through XMPP."
msgstr ""
"Velger denne nøkkelen for XEP-0373/0374-meldinger og publiserer den gjennom "
"XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:715
msgid "OpenPGP for XMPP Key Selected"
msgstr "OpenPGP-for-XMPP-nøkkel valgt"

#: plugins/openpgp/src/key_management_dialog.vala:715
msgid ""
"DinoX will use this key for OpenPGP for XMPP and publish it through XMPP for"
" this account."
msgstr ""
"DinoX bruker denne nøkkelen til OpenPGP for XMPP og publiserer den gjennom "
"XMPP for denne kontoen."

#: plugins/openpgp/src/key_management_dialog.vala:723
#: plugins/openpgp/src/key_management_dialog.vala:2237
msgid "Backup Secret Key to Server"
msgstr "Sikkerhetskopier hemmelig nøkkel til server"

#: plugins/openpgp/src/key_management_dialog.vala:724
msgid ""
"Securely encrypt this key and store it on the server to sync across your "
"devices."
msgstr ""
"Krypter denne nøkkelen sikkert og lagre den på serveren for å synkronisere "
"mellom enhetene dine."

#: plugins/openpgp/src/key_management_dialog.vala:735
msgid "Disable OpenPGP for XMPP for this account"
msgstr "Deaktiver OpenPGP for XMPP for denne kontoen"

#: plugins/openpgp/src/key_management_dialog.vala:736
msgid ""
"Removes the XMPP PubSub publication and keeps the secret key locally. Legacy"
" XEP-0027/keyserver state is not changed."
msgstr ""
"Fjerner XMPP-PubSub-publiseringen og beholder den hemmelige nøkkelen lokalt."
" Tilstanden for eldre XEP-0027/nøkkelserver endres ikke."

#: plugins/openpgp/src/key_management_dialog.vala:747
msgid "Legacy keyserver publication"
msgstr "Publisering på eldre nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:749
msgid ""
"This key is revoked, expired, or not usable for signing and encryption."
msgstr ""
"Denne nøkkelen er tilbakekalt, utløpt eller kan ikke brukes til signering og"
" kryptering."

#: plugins/openpgp/src/key_management_dialog.vala:751
msgid ""
"Stored for legacy XEP-0027/keyserver, but this key has no email user ID for "
"new keyserver publishing."
msgstr ""
"Lagret for eldre XEP-0027/nøkkelserver, men nøkkelen har ingen bruker-ID med"
" e-postadresse for ny publisering på en nøkkelserver."

#: plugins/openpgp/src/key_management_dialog.vala:753
msgid ""
"Active for legacy XEP-0027. The email address on the key must still be "
"verified on the keyserver."
msgstr ""
"Aktiv for eldre XEP-0027. E-postadressen på nøkkelen må fortsatt verifiseres"
" på nøkkelserveren."

#: plugins/openpgp/src/key_management_dialog.vala:755
msgid ""
"Stored for legacy XEP-0027/keyserver, but not active while OpenPGP for XMPP "
"mode is selected."
msgstr ""
"Lagret for eldre XEP-0027/nøkkelserver, men ikke aktiv mens OpenPGP for "
"XMPP-modus er valgt."

#: plugins/openpgp/src/key_management_dialog.vala:757
msgid ""
"Uploaded for legacy OpenPGP clients. The email address on the key must still"
" be verified on the keyserver."
msgstr ""
"Lastet opp for eldre OpenPGP-klienter. E-postadressen på nøkkelen må "
"fortsatt verifiseres på nøkkelserveren."

#: plugins/openpgp/src/key_management_dialog.vala:759
msgid ""
"Not uploaded. Legacy OpenPGP clients may not find this key unless you "
"publish it to a keyserver."
msgstr ""
"Ikke lastet opp. Eldre OpenPGP-klienter finner kanskje ikke denne nøkkelen "
"med mindre du publiserer den på en nøkkelserver."

#: plugins/openpgp/src/key_management_dialog.vala:768
msgid "Selected for legacy XEP-0027/keyserver"
msgstr "Valgt for eldre XEP-0027/nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:769
msgid "Use for legacy XEP-0027/keyserver"
msgstr "Bruk for eldre XEP-0027/nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:771
msgid ""
"DinoX uses this key for legacy OpenPGP messages and keyserver-based "
"contacts."
msgstr ""
"DinoX bruker denne nøkkelen til eldre OpenPGP-meldinger og "
"nøkkelserverbaserte kontakter."

#: plugins/openpgp/src/key_management_dialog.vala:773
msgid ""
"Selects this key for legacy OpenPGP messages. The keyserver entry still "
"needs a verified email address."
msgstr ""
"Velger denne nøkkelen for eldre OpenPGP-meldinger. Nøkkelserveroppføringen "
"trenger fortsatt en verifisert e-postadresse."

#: plugins/openpgp/src/key_management_dialog.vala:780
#: plugins/openpgp/src/key_management_dialog.vala:790
msgid "Legacy OpenPGP Key Selected"
msgstr "Eldre OpenPGP-nøkkel valgt"

#: plugins/openpgp/src/key_management_dialog.vala:780
msgid "DinoX will use this key for XEP-0027/keyserver OpenPGP."
msgstr "DinoX bruker denne nøkkelen til XEP-0027-/nøkkelserver-OpenPGP."

#: plugins/openpgp/src/key_management_dialog.vala:783
msgid ""
"Not published to a keyserver. You can select it, but other legacy clients "
"may not find it automatically."
msgstr ""
"Ikke publisert på en nøkkelserver. Du kan velge den, men andre eldre "
"klienter finner den kanskje ikke automatisk."

#: plugins/openpgp/src/key_management_dialog.vala:790
msgid ""
"DinoX will use this key for XEP-0027. Publish it to a keyserver if legacy "
"clients should find it automatically."
msgstr ""
"DinoX bruker denne nøkkelen til XEP-0027. Publiser den på en nøkkelserver "
"hvis eldre klienter skal finne den automatisk."

#: plugins/openpgp/src/key_management_dialog.vala:802
msgid "Stop using for legacy XEP-0027/keyserver"
msgstr "Slutt å bruke for eldre XEP-0027/nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:803
msgid "Remove stored legacy XEP-0027/keyserver selection"
msgstr "Fjern lagret valg for eldre XEP-0027/nøkkelserver"

#: plugins/openpgp/src/key_management_dialog.vala:805
msgid ""
"Keeps the key locally and on the keyserver. DinoX stops announcing it in "
"signed presence."
msgstr ""
"Beholder nøkkelen lokalt og på nøkkelserveren. DinoX slutter å annonsere den"
" i signert tilstedeværelse."

#: plugins/openpgp/src/key_management_dialog.vala:806
msgid ""
"Keeps the key locally and on the keyserver. DinoX removes this inactive "
"legacy account selection."
msgstr ""
"Beholder nøkkelen lokalt og på nøkkelserveren. DinoX fjerner dette inaktive "
"valget av eldre kontonøkkel."

#: plugins/openpgp/src/key_management_dialog.vala:813
msgid "Legacy OpenPGP Disabled"
msgstr "Eldre OpenPGP deaktivert"

#: plugins/openpgp/src/key_management_dialog.vala:813
msgid ""
"DinoX will no longer use or announce this key for XEP-0027/keyserver "
"OpenPGP. The key remains in your keyring and on the keyserver if it was "
"published."
msgstr ""
"DinoX bruker eller annonserer ikke lenger denne nøkkelen for "
"XEP-0027-/nøkkelserver-OpenPGP. Nøkkelen forblir i nøkkelringen og på "
"nøkkelserveren hvis den ble publisert."

#: plugins/openpgp/src/key_management_dialog.vala:821
msgid "Publish public key to keyserver for legacy discovery"
msgstr ""
"Publiser offentlig nøkkel på nøkkelserver for oppdagelse i eldre klienter"

#: plugins/openpgp/src/key_management_dialog.vala:822
msgid "Requires a real email address you can verify."
msgstr "Krever en ekte e-postadresse du kan verifisere."

#: plugins/openpgp/src/key_management_dialog.vala:831
#: plugins/openpgp/src/key_management_dialog.vala:1333
msgid "Export Public Key"
msgstr "Eksporter offentlig nøkkel"

#: plugins/openpgp/src/key_management_dialog.vala:839
#: plugins/openpgp/src/key_management_dialog.vala:1330
