#: plugins/openpgp/src/contact_details_provider.vala:53
msgid "OpenPGP Legacy (XEP-0027/keyserver)"
msgstr "OpenPGP Legacy (XEP-0027/Keyserver)"

#: plugins/openpgp/src/contact_details_provider.vala:63
msgid "Search keyserver"
msgstr "Keyserver durchsuchen"

#: plugins/openpgp/src/contact_details_provider.vala:71
msgid "OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/contact_details_provider.vala:82
msgid "Refresh XMPP-published key"
msgstr "Über XMPP veröffentlichten Schlüssel aktualisieren"

#: plugins/openpgp/src/contact_details_provider.vala:114
msgid "Checking XMPP-published OpenPGP key..."
msgstr "Über XMPP veröffentlichter OpenPGP-Schlüssel wird geprüft..."

#: plugins/openpgp/src/contact_details_provider.vala:188
msgid "Checking the XMPP-published OpenPGP key timed out."
msgstr "Prüfung des über XMPP veröffentlichten OpenPGP-Schlüssels ist abgelaufen."

#: plugins/openpgp/src/contact_details_provider.vala:114
msgid "Checking keyring..."
msgstr "Schlüsselring wird geprüft..."

#: plugins/openpgp/src/contact_details_provider.vala:136
msgid "Key not in keyring"
msgstr "Schlüssel nicht im Schlüsselbund"

#: plugins/openpgp/src/contact_details_provider.vala:170
msgid "Active: legacy XEP-0027/keyserver key is currently usable for this contact."
msgstr "Aktiv: Legacy-XEP-0027/Keyserver-Schlüssel ist für diesen Kontakt aktuell nutzbar."

#: plugins/openpgp/src/contact_details_provider.vala:173
msgid ""
"Stored: legacy XEP-0027/keyserver key is known, but is not currently active "
"for this contact."
msgstr ""
"Gespeichert: Legacy-XEP-0027/Keyserver-Schlüssel ist bekannt, für diesen "
"Kontakt aktuell aber nicht aktiv."

#: plugins/openpgp/src/contact_details_provider.vala:143
msgid "Inactive: no legacy XEP-0027/keyserver key is stored."
msgstr "Inaktiv: kein Legacy-XEP-0027/Keyserver-Schlüssel gespeichert."

#: plugins/openpgp/src/contact_details_provider.vala:147
msgid "Active: XMPP-published OpenPGP key is stored."
msgstr "Aktiv: über XMPP veröffentlichter OpenPGP-Schlüssel ist gespeichert."

#: plugins/openpgp/src/contact_details_provider.vala:149
msgid ""
"Supported: contact advertises OpenPGP for XMPP, but no retrievable XMPP-"
"published key is stored."
msgstr ""
"Unterstützt: Kontakt kündigt OpenPGP for XMPP an, aber es ist kein "
"abrufbarer über XMPP veröffentlichter Schlüssel gespeichert."

#: plugins/openpgp/src/contact_details_provider.vala:151
msgid "Inactive: no OpenPGP-for-XMPP support or XMPP-published key is known."
msgstr ""
"Inaktiv: keine OpenPGP-for-XMPP-Unterstützung und kein über XMPP "
"veröffentlichter Schlüssel bekannt."

#: plugins/openpgp/src/contact_details_provider.vala:165
msgid "Searching keyserver with fingerprint: "
msgstr "Keyserver wird mit Fingerabdruck durchsucht: "

#: plugins/openpgp/src/contact_details_provider.vala:177
msgid ""
"Key not found or has no verified email on keyserver.\n"
"Ask the contact to verify their email on keys.openpgp.org\n"
"or send you their public key file directly."
msgstr ""
"Schlüssel nicht gefunden oder ohne bestätigte E-Mail-Adresse auf dem "
"Keyserver.\n"
"Bitte den Kontakt, seine E-Mail-Adresse auf keys.openpgp.org zu bestätigen\n"
"oder dir seine öffentliche Schlüsseldatei direkt zu senden."

#: plugins/openpgp/src/contact_details_provider.vala:179
msgid "Failed: "
msgstr "Fehlgeschlagen: "

#: plugins/openpgp/src/contact_details_provider.vala:185
msgid "Searching keyserver with JID..."
msgstr "Keyserver wird mit JID durchsucht..."

#: plugins/openpgp/src/contact_details_provider.vala:199
msgid "Not found with JID. Enter email address:"
msgstr "Mit JID nicht gefunden. E-Mail-Adresse eingeben:"

#: plugins/openpgp/src/contact_details_provider.vala:209
msgid "Enter Email Address"
msgstr "E-Mail-Adresse eingeben"

#: plugins/openpgp/src/contact_details_provider.vala:210
msgid ""
"The key was not found using the JID.\n"
"\n"
"Enter the email address that is in the contact's OpenPGP key:"
msgstr ""
"Der Schlüssel wurde mit der JID nicht gefunden.\n"
"\n"
"Gib die E-Mail-Adresse ein, die im OpenPGP-Schlüssel des Kontakts steht:"

