msgstr ""
"Deine geheime Schlüssel-Sicherung oder öffentliche Schlüssel von Kontakten"

#: plugins/openpgp/src/key_management_dialog.vala:143
msgid "Your Keys"
msgstr "Deine Schlüssel"

#: plugins/openpgp/src/key_management_dialog.vala:144
msgid "Private keys available for signing and decryption"
msgstr "Private Schlüssel verfügbar für Signierung und Entschlüsselung"

#: plugins/openpgp/src/key_management_dialog.vala:190
#: plugins/openpgp/src/key_management_dialog.vala:200
#: plugins/openpgp/src/key_management_dialog.vala:243
msgid "GnuPG did not respond."
msgstr "GnuPG hat nicht geantwortet."

#: plugins/openpgp/src/key_management_dialog.vala:242
msgid "Could not load OpenPGP keys"
msgstr "OpenPGP-Schlüssel konnten nicht geladen werden"

#: plugins/openpgp/src/key_management_dialog.vala:187
msgid "No private keys found"
msgstr "Keine privaten Schlüssel gefunden"

#: plugins/openpgp/src/key_management_dialog.vala:188
msgid "Generate or import a key to get started"
msgstr "Erzeuge oder importiere einen Schlüssel, um zu beginnen"

#: plugins/openpgp/src/key_management_dialog.vala:276
#: plugins/openpgp/src/key_management_dialog.vala:278
msgid "Revoked"
msgstr "Widerrufen"

#: plugins/openpgp/src/key_management_dialog.vala:516
msgid "Active OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374) aktiv"

#: plugins/openpgp/src/key_management_dialog.vala:518
msgid "Stored OpenPGP XMPP (XEP-0373/0374)"
msgstr "OpenPGP XMPP (XEP-0373/0374) gespeichert"

#: plugins/openpgp/src/key_management_dialog.vala:520
msgid "OpenPGP XMPP key (XEP-0373/0374)"
msgstr "OpenPGP-XMPP-Schlüssel (XEP-0373/0374)"

#: plugins/openpgp/src/key_management_dialog.vala:524
msgid "Active legacy XEP-0027/keyserver"
msgstr "Legacy-XEP-0027/Keyserver aktiv"

#: plugins/openpgp/src/key_management_dialog.vala:526
msgid "Stored legacy XEP-0027/keyserver"
msgstr "Legacy-XEP-0027/Keyserver gespeichert"

#: plugins/openpgp/src/key_management_dialog.vala:528
msgid "Legacy-capable key"
msgstr "Legacy-fähiger Schlüssel"

#: plugins/openpgp/src/key_management_dialog.vala:532
msgid "Keyserver uploaded"
msgstr "Auf Keyserver hochgeladen"

#: plugins/openpgp/src/key_management_dialog.vala:287
msgid "Published to keyserver"
msgstr "Auf Keyserver veröffentlicht"

#: plugins/openpgp/src/key_management_dialog.vala:293
msgid "Active legacy and XMPP account key"
msgstr "Aktiver Legacy- und XMPP-Kontoschlüssel"

#: plugins/openpgp/src/key_management_dialog.vala:294
msgid "Active legacy XEP-0027 account key"
msgstr "Aktiver Legacy-XEP-0027-Kontoschlüssel"

#: plugins/openpgp/src/key_management_dialog.vala:294
msgid "Active XMPP account key"
msgstr "Aktiver XMPP-Kontoschlüssel"

#: plugins/openpgp/src/key_management_dialog.vala:300
msgid "Fingerprint"
msgstr "Fingerabdruck"

#: plugins/openpgp/src/key_management_dialog.vala:311
msgid "OpenPGP for XMPP (XEP-0373/0374)"
msgstr "OpenPGP for XMPP (XEP-0373/0374)"

#: plugins/openpgp/src/key_management_dialog.vala:313
msgid ""
"Active for this account. DinoX publishes this key through XMPP for OpenPGP-"
"capable clients."
msgstr ""
"Für dieses Konto aktiv. DinoX veröffentlicht diesen Schlüssel über XMPP für "
"OpenPGP-fähige Clients."

#: plugins/openpgp/src/key_management_dialog.vala:314
msgid ""
"Stored for OpenPGP for XMPP, but not active while legacy XEP-0027/keyserver "
"mode is selected."
msgstr ""
"Für OpenPGP for XMPP gespeichert, aber nicht aktiv, solange der Legacy-XEP-"
"0027/Keyserver-Modus ausgewählt ist."

#: plugins/openpgp/src/key_management_dialog.vala:315
msgid ""
"Inactive. This key is currently selected for legacy XEP-0027/keyserver use."
msgstr ""
"Inaktiv. Dieser Schlüssel ist aktuell für Legacy-XEP-0027/Keyserver-Nutzung "
"ausgewählt."

#: plugins/openpgp/src/key_management_dialog.vala:317
msgid ""
"Not available for this account. OpenPGP for XMPP keys must contain an xmpp: "
"user ID for this XMPP address."
msgstr ""
"Für dieses Konto nicht verfügbar. OpenPGP-for-XMPP-Schlüssel müssen eine "
"xmpp:-Benutzerkennung für diese XMPP-Adresse enthalten."

#: plugins/openpgp/src/key_management_dialog.vala:317
msgid "Not active for this account. Select it below to publish it through XMPP."
msgstr ""
"Für dieses Konto nicht aktiv. Wähle ihn unten aus, um ihn über XMPP zu "
"veröffentlichen."

#: plugins/openpgp/src/key_management_dialog.vala:329
msgid "Selected for OpenPGP for XMPP"
msgstr "Für OpenPGP for XMPP ausgewählt"

#: plugins/openpgp/src/key_management_dialog.vala:330
msgid "Use for OpenPGP for XMPP"
msgstr "Für OpenPGP for XMPP verwenden"

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid ""
"DinoX uses this key for XEP-0373/0374 messages and publishes it through XMPP."
msgstr ""
"DinoX nutzt diesen Schlüssel für XEP-0373/0374-Nachrichten und "
"veröffentlicht ihn über XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:335
msgid ""
"Selects this key for XEP-0373/0374 messages and publishes it through XMPP."
msgstr ""
"Wählt diesen Schlüssel für XEP-0373/0374-Nachrichten aus und veröffentlicht "
"ihn über XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:342
msgid "OpenPGP for XMPP Key Selected"
msgstr "OpenPGP-for-XMPP-Schlüssel ausgewählt"

#: plugins/openpgp/src/key_management_dialog.vala:342
msgid ""
"DinoX will use this key for OpenPGP for XMPP and publish it through XMPP for "
"this account."
msgstr ""
"DinoX nutzt diesen Schlüssel für OpenPGP for XMPP und veröffentlicht ihn für "
"dieses Konto über XMPP."

#: plugins/openpgp/src/key_management_dialog.vala:324
msgid "Disable OpenPGP for XMPP for this account"
msgstr "OpenPGP for XMPP für dieses Konto deaktivieren"

#: plugins/openpgp/src/key_management_dialog.vala:325
msgid ""
"Removes the XMPP PubSub publication and keeps the secret key locally. Legacy "
"XEP-0027/keyserver state is not changed."
msgstr ""
"Entfernt die XMPP-PubSub-Veröffentlichung und behält den geheimen Schlüssel "
"lokal. Der Legacy-XEP-0027/Keyserver-Zustand wird nicht geändert."

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "OpenPGP for XMPP Disabled"
msgstr "OpenPGP for XMPP deaktiviert"

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "Disable OpenPGP for XMPP?"
msgstr "OpenPGP for XMPP deaktivieren?"

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid ""
"This removes the XMPP PubSub publication and stops using this key for "
"XEP-0373/0374 on this account. The secret key stays local and legacy "
"XEP-0027/keyserver state is not changed."
msgstr ""
"Dies entfernt die XMPP-PubSub-Veröffentlichung und stoppt die Nutzung dieses "
"Schlüssels für XEP-0373/0374 auf diesem Konto. Der geheime Schlüssel bleibt "
"lokal und der Legacy-XEP-0027/Keyserver-Zustand wird nicht geändert."

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "Disable XMPP Publishing"
msgstr "XMPP-Veröffentlichung deaktivieren"

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "Disabling OpenPGP for XMPP..."
msgstr "OpenPGP for XMPP wird deaktiviert..."

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "Removing the XMPP PubSub publication..."
msgstr "XMPP-PubSub-Veröffentlichung wird entfernt..."

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid ""
"DinoX no longer publishes this key through XMPP PubSub for this account. The "
"secret key stays local and legacy XEP-0027/keyserver state was not changed."
msgstr ""
"DinoX veröffentlicht diesen Schlüssel für dieses Konto nicht mehr über XMPP "
"PubSub. Der geheime Schlüssel bleibt lokal und der Legacy-XEP-0027/"
"Keyserver-Zustand wurde nicht geändert."

#: plugins/openpgp/src/key_management_dialog.vala:332
msgid "Could not remove the XMPP publication. OpenPGP for XMPP was not disabled."
msgstr ""
"Die XMPP-Veröffentlichung konnte nicht entfernt werden. OpenPGP for XMPP "
"wurde nicht deaktiviert."

#: plugins/openpgp/src/key_management_dialog.vala:338
msgid "Legacy keyserver publication"
msgstr "Legacy-Keyserver-Veröffentlichung"

#: plugins/openpgp/src/key_management_dialog.vala:340
msgid "This key is revoked, expired, or not usable for signing and encryption."
msgstr ""
"Dieser Schlüssel ist widerrufen, abgelaufen oder nicht für Signierung und "
"Verschlüsselung nutzbar."

#: plugins/openpgp/src/key_management_dialog.vala:341
msgid ""
"Stored for legacy XEP-0027/keyserver, but this key has no email user ID for "
"new keyserver publishing."
msgstr ""
"Für Legacy-XEP-0027/Keyserver gespeichert, aber dieser Schlüssel hat keine "
"E-Mail-Benutzerkennung für neue Keyserver-Veröffentlichung."

#: plugins/openpgp/src/key_management_dialog.vala:342
msgid ""
"Active for legacy XEP-0027. The email address on the key must still be "
"verified on the keyserver."
msgstr ""
"Für Legacy-XEP-0027 aktiv. Die E-Mail-Adresse des Schlüssels muss auf dem "
"Keyserver trotzdem bestätigt sein."

#: plugins/openpgp/src/key_management_dialog.vala:374
msgid ""
"Not available for legacy keyserver publishing. This key has no email user ID."
msgstr ""
"Für Legacy-Keyserver-Veröffentlichung nicht verfügbar. Dieser Schlüssel "
"hat keine E-Mail-Benutzerkennung."

#: plugins/openpgp/src/key_management_dialog.vala:344
msgid ""
"Uploaded for legacy OpenPGP clients. The email address on the key must still "
"be verified on the keyserver."
msgstr ""
"Für ältere OpenPGP-Clients hochgeladen. Die E-Mail-Adresse des Schlüssels "
"muss auf dem Keyserver trotzdem bestätigt sein."

#: plugins/openpgp/src/key_management_dialog.vala:346
msgid ""
"Not uploaded. Legacy OpenPGP clients may not find this key unless you "
"publish it to a keyserver."
msgstr ""
"Nicht hochgeladen. Ältere OpenPGP-Clients finden diesen Schlüssel "
"möglicherweise nicht, solange du ihn nicht auf einem Keyserver "
"veröffentlichst."

#: plugins/openpgp/src/key_management_dialog.vala:354
msgid "Selected for legacy XEP-0027/keyserver"
msgstr "Für Legacy-XEP-0027/Keyserver ausgewählt"

#: plugins/openpgp/src/key_management_dialog.vala:355
msgid "Use for legacy XEP-0027/keyserver"
msgstr "Für Legacy-XEP-0027/Keyserver verwenden"

#: plugins/openpgp/src/key_management_dialog.vala:357
msgid ""
"DinoX uses this key for legacy OpenPGP messages and keyserver-based contacts."
msgstr ""
"DinoX nutzt diesen Schlüssel für Legacy-OpenPGP-Nachrichten und Kontakte mit "
"Keyserver-Schlüsseln."

#: plugins/openpgp/src/key_management_dialog.vala:359
msgid ""
"Selects this key for legacy OpenPGP messages. The keyserver entry still "
"needs a verified email address."
msgstr ""
"Wählt diesen Schlüssel für Legacy-OpenPGP-Nachrichten aus. Der Keyserver-"
