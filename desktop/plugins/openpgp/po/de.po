msgstr "Fehler in GnuPG"

#: plugins/openpgp/src/encryption_preferences_entry.vala:62
msgid "No keys available. Generate or import one!"
msgstr "Keine Schlüssel vorhanden. Erzeuge oder importiere einen!"

#: plugins/openpgp/src/encryption_preferences_entry.vala:106
msgid ""
"DinoX currently sends OpenPGP as legacy XEP-0027 using keyserver/contact "
"keys."
msgstr ""
"DinoX sendet OpenPGP aktuell als Legacy-XEP-0027 mit Keyserver-/"
"Kontaktschlüsseln."

#: plugins/openpgp/src/encryption_preferences_entry.vala:109
msgid "DinoX currently sends OpenPGP for XMPP using XEP-0373/0374."
msgstr "DinoX sendet OpenPGP aktuell als OpenPGP for XMPP mit XEP-0373/0374."

#: plugins/openpgp/src/encryption_preferences_entry.vala:112
msgid "No OpenPGP send key is active for this account."
msgstr "Für dieses Konto ist kein OpenPGP-Sendeschlüssel aktiv."

#: plugins/openpgp/src/key_management_dialog.vala:1176
msgid "OK"
msgstr "OK"

#: plugins/openpgp/src/plugin.vala:329
