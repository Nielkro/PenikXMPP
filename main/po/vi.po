#: main/src/ui/feeds_dialog.vala:55
msgid ""
"A feed is a list of new posts, such as news or software releases. Here you "
"can read feeds, share posts in chats or publish your own posts."
msgstr ""
"Nguồn tin là danh sách bài đăng mới, chẳng hạn tin tức hoặc bản phát hành "
"phần mềm. Tại đây, bạn có thể đọc nguồn tin, chia sẻ bài đăng trong cuộc trò"
" chuyện hoặc đăng bài của mình."

#: main/src/ui/feeds_dialog.vala:75
msgid "Read RSS or Atom feeds and share individual articles in a chat."
msgstr ""
"Đọc nguồn tin RSS hoặc Atom và chia sẻ từng bài viết trong cuộc trò chuyện."

#: main/src/ui/feeds_dialog.vala:76
