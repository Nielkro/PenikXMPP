<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="DinoUiBotCreateDialog" parent="AdwDialog">
    <property name="title" translatable="yes">New Botmother</property>
    <property name="content-width">400</property>
    <property name="content-height">640</property>
    <property name="follows-content-size">False</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="decoration-layout">:</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="create_button">
                <property name="label" translatable="yes">Create</property>
                <property name="sensitive">False</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="content_stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">form</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">400</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">16</property>
                        <property name="margin-end">16</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">16</property>
                            <child>
                              <object class="GtkBox" id="avatar_row">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">16</property>
                                <property name="halign">center</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkOverlay" id="avatar_overlay">
                                    <child>
                                      <object class="GtkImage" id="avatar_preview">
                                        <property name="pixel-size">72</property>
                                        <property name="icon-name">avatar-default-symbolic</property>
                                        <style>
                                          <class name="icon-dropshadow"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="valign">center</property>
                                    <property name="spacing">4</property>
                                    <child>
                                      <object class="GtkButton" id="avatar_button">
                                        <property name="label" translatable="yes">Choose Avatar</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="avatar_remove_button">
                                        <property name="label" translatable="yes">Remove</property>
                                        <property name="visible">False</property>
                                        <style>
                                          <class name="flat"/>
                                          <class name="destructive-action"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                            <child>
                              <object class="AdwEntryRow" id="name_entry">
                                <property name="title" translatable="yes">Botmother Name</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="purpose_combo">
                                <property name="title" translatable="yes">Bot purpose</property>
                                <property name="subtitle" translatable="yes">Choose the main feature this bot should provide</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="mode_combo">
                                <property name="title" translatable="yes">Mode</property>
                                <property name="subtitle" translatable="yes">How the Botmother connects to XMPP</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="dedicated_provisioning_combo">
                                <property name="title" translatable="yes">Dedicated account</property>
                                <property name="subtitle" translatable="yes">Use an existing bot account or create one with ejabberd</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwExpanderRow" id="ejabberd_settings_row">
                                <property name="title" translatable="yes">ejabberd Admin API</property>
                                <property name="subtitle" translatable="yes">Only needed to create a new dedicated bot account on your server</property>
                                <property name="visible">False</property>
                                <property name="expanded">True</property>
                                <child>
                                  <object class="AdwEntryRow" id="ejabberd_url_entry">
                                    <property name="title" translatable="yes">API URL</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwEntryRow" id="ejabberd_host_entry">
                                    <property name="title" translatable="yes">XMPP host</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwEntryRow" id="ejabberd_admin_entry">
                                    <property name="title" translatable="yes">Admin JID</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="ejabberd_password_entry">
                                    <property name="title" translatable="yes">Admin password</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="ejabberd_actions_row">
                                    <property name="title" translatable="yes">Server settings</property>
                                    <property name="subtitle" translatable="yes">Not configured</property>
                                    <child type="suffix">
                                      <object class="GtkButton" id="ejabberd_clear_button">
                                        <property name="label" translatable="yes">Clear</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="ejabberd_test_button">
                                        <property name="label" translatable="yes">Test</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="ejabberd_save_button">
                                        <property name="label" translatable="yes">Save</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="bot_jid_entry">
                                <property name="title" translatable="yes">Bot JID</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="bot_password_entry">
                                <property name="title" translatable="yes">Bot password</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPasswordEntryRow" id="cloud_token_entry">
                                <property name="title" translatable="yes">CloudBot management token</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                            <child>
                              <object class="AdwEntryRow" id="webhook_entry">
                                <property name="title" translatable="yes">Webhook URL (optional)</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkListBox" id="permissions_list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="mode_description">
                            <property name="label" translatable="yes">The Botmother will use your XMPP account to send and receive messages via the local API.</property>
                            <property name="wrap">True</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="error_label">
                            <property name="visible">False</property>
                            <property name="wrap">True</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="error"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">success</property>
                <property name="child">
                  <object class="AdwStatusPage" id="success_page">
                    <property name="icon-name">check-plain-symbolic</property>
                    <property name="title" translatable="yes">Botmother Created</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <child>
                              <object class="GtkLabel" id="jid_heading_label">
                                <property name="label" translatable="yes">Bot JID:</property>
                                <property name="xalign">0</property>
                                <property name="visible">False</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="jid_label">
                                <property name="selectable">True</property>
                                <property name="wrap">True</property>
                                <property name="xalign">0</property>
                                <property name="visible">False</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">4</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Your API Token:</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="token_label">
                                <property name="selectable">True</property>
                                <property name="wrap">True</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="copy_token_button">
                            <property name="label" translatable="yes">Copy Token</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Save this token securely. It will not be shown again.</property>
                            <property name="wrap">True</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                              <class name="warning"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">creating</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkSpinner">
                        <property name="spinning">True</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
